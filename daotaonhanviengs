function appendWeekIfMissing_(ss, week) {
  var weeks = readWeeks_(ss);
  if (weeks.some(function (w) { return w.id === week.id; })) return 0;
  weeks.push(week);
  writeWeeks_(ss, weeks);
  return 1;
}

