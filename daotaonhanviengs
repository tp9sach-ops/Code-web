/*************************************************************
 * ---- Bỏ giới hạn 15 câu trong hàm TẠO BÀI HỌC LIÊN KẾT KIỂU CŨ
 * (adminCreateCustomLesson — hàm dự phòng phía server, ít dùng vì
 * Index.html hiện tại dùng adminCreateCustomLessonFromData xử lý ở
 * trình duyệt). Dán hàm này ĐÈ LÊN hàm adminCreateCustomLesson cũ
 * trong Code.gs (xóa hàm cũ, thay bằng bản dưới) để đồng bộ hành vi:
 * lấy TOÀN BỘ câu hỏi thật có sẵn, không cắt bớt về 15, và chỉ sinh
 * thêm câu hỏi Đúng/Sai cho mục nào thực sự chưa có câu hỏi nào.
 *************************************************************/
function adminCreateCustomLesson(password, title, refs) {
  checkPassword_(password);
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var data = getAppData();
  var contentBlocks = [];
  var quizPool = [];
  (refs || []).forEach(function (ref) {
    if (ref.type === 'lesson') {
      data.weeks.forEach(function (w) {
        w.lessons.forEach(function (l) {
          if (l.id === ref.id) {
            contentBlocks.push({ title: l.title, body: l.content + (l.script ? ('\n\nKịch bản: ' + l.script) : '') });
            (l.quiz || []).forEach(function (q) { quizPool.push(q); });
          }
        });
      });
    } else if (ref.type === 'sop') {
      var s = data.sop.filter(function (x) { return x.id === ref.id; })[0];
      if (s) contentBlocks.push({ title: s.situation, body: 'Cách xử lý: ' + s.solution + (s.note ? ('\n\nLưu ý: ' + s.note) : '') });
    } else if (ref.type === 'guide') {
      var g = data.operationGuides.filter(function (x) { return x.id === ref.id; })[0];
      if (g) contentBlocks.push({ title: g.title, body: (g.steps || []).join('\n') + (g.note ? ('\n\nLưu ý: ' + g.note) : '') });
    } else if (ref.type === 'script') {
      var sc = data.salesScripts.filter(function (x) { return x.id === ref.id; })[0];
      if (sc) contentBlocks.push({ title: sc.situation, body: sc.script + (sc.tip ? ('\n\nMẹo: ' + sc.tip) : '') });
    } else if (ref.type === 'skill') {
      var sk = data.sellingSkills.filter(function (x) { return x.id === ref.id; })[0];
      if (sk) contentBlocks.push({ title: sk.title, body: sk.desc + (sk.example ? ('\n\nVí dụ: ' + sk.example) : '') });
    } else if (ref.type === 'productLine') {
      var p = data.productLines.filter(function (x) { return x.id === ref.id; })[0];
      if (p) contentBlocks.push({ title: p.name, body: 'Thành phần: ' + p.ingredients + '\nBảo quản đông lạnh: ' + p.storageFrozen + '\nBảo quản mát: ' + p.storageCold05 });
    } else if (ref.type === 'qlch') {
      var q1 = data.qlchContent.filter(function (x) { return x.id === ref.id; })[0];
      if (q1) contentBlocks.push({ title: (q1.title || q1.question), body: (q1.content || q1.answer) || '(Chưa có nội dung, Admin bổ sung sau)' });
    } else if (ref.type === 'b2b') {
      var b1 = data.b2bTopics.filter(function (x) { return x.id === ref.id; })[0];
      if (b1) contentBlocks.push({ title: (b1.title || b1.topic), body: (b1.content || b1.detail) || '(Chưa có nội dung chi tiết, Admin bổ sung sau)' });
    }
  });
  // v9: KHÔNG còn cắt về 15 câu — lấy TOÀN BỘ câu hỏi thật (quizPool) đã
  // gắn sẵn với nội dung được chọn, để bảo đảm câu hỏi luôn bám sát và
  // giúp ghi nhớ đúng nội dung bài học thay vì bị giới hạn số lượng.
  var quiz = quizPool.map(function (q) { return { question: q.question, options: q.options, answerIndex: q.answerIndex, explain: q.explain || '' }; });
  // Chỉ sinh thêm câu hỏi Đúng/Sai từ nội dung khi HOÀN TOÀN chưa có câu
  // hỏi thật nào (quizPool rỗng) — không sinh thêm để "lấp đầy" cho đủ số.
  if (!quiz.length) {
    var qi = 0, guard = 0;
    var fallbackTarget = Math.max(6, contentBlocks.length * 3);
    while (quiz.length < fallbackTarget && contentBlocks.length && guard < 300) {
      guard++;
      var block = contentBlocks[qi % contentBlocks.length];
      qi++;
      var sentences = (block.body || '').split(/[\n\.;]+/).map(function (s) { return s.trim(); }).filter(function (s) { return s.length >= 15 && s.length <= 100; });
      if (!sentences.length) continue;
      var sPick = sentences[Math.floor(Math.random() * sentences.length)];
      quiz.push({
        question: 'Nội dung sau có ĐÚNG với phần "' + block.title + '" không? "' + sPick + '"',
        options: ['Đúng', 'Sai'], answerIndex: 0, explain: 'Trích trực tiếp từ nội dung bài học.'
      });
    }
  }
  var lesson = {
    id: genLessonId_(), title: title, createdAt: new Date().toISOString(),
    content: contentBlocks, quiz: quiz, active: true, leaderboard: []
  };
  var list = readCollection_(ss, COLLECTION_SHEETS.customLessons);
  list.push(lesson);
  writeCollection_(ss, COLLECTION_SHEETS.customLessons, list);
  return lesson;
}
function getLessonLeaderboard(dayId) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var shTD = ss.getSheetByName(SHEET_TIENDO);
  var data = shTD.getDataRange().getValues();
  var shNV = ss.getSheetByName(SHEET_NHANVIEN);
  var nvData = shNV.getDataRange().getValues();
  var nameByPhone = {};
  for (var i = 1; i < nvData.length; i++) nameByPhone[String(nvData[i][0])] = nvData[i][1];

  var list = [];
  for (var j = 1; j < data.length; j++) {
    if (data[j][1] !== dayId) continue;
    var phone = String(data[j][0]);
    list.push({
      name: nameByPhone[phone] || phone,
      correct: Number(data[j][2]) || 0,
      total: Number(data[j][3]) || 0,
      durationSec: Number(data[j][6]) || 0
    });
  }
  list.sort(function (a, b) {
    if (b.correct !== a.correct) return b.correct - a.correct;
    return (a.durationSec || 999999) - (b.durationSec || 999999);
  });
  return list;
}
function submitCustomLessonScore(lessonId, name, score, total, durationSec) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var list = readCollection_(ss, COLLECTION_SHEETS.customLessons);
  var lesson = list.filter(function (l) { return l.id === lessonId; })[0];
  if (!lesson) throw new Error('Bài học không tồn tại.');
  lesson.leaderboard = lesson.leaderboard || [];
  lesson.leaderboard.push({
    name: String(name || 'Ẩn danh').trim().slice(0, 60),
    score: score, total: total,
    durationSec: Number(durationSec) || 0,
    date: new Date().toISOString()
  });
  lesson.leaderboard.sort(function (a, b) {
    if (b.score !== a.score) return b.score - a.score;
    return (a.durationSec || 999999) - (b.durationSec || 999999);
  });
  lesson.leaderboard = lesson.leaderboard.slice(0, 500); // giới hạn lưu trữ, không giới hạn hiển thị
  writeCollection_(ss, COLLECTION_SHEETS.customLessons, list.map(function (l) { return l.id === lessonId ? lesson : l; }));
  return { ok: true, leaderboard: lesson.leaderboard };
}
function getCustomLesson(lessonId) {
  var list = readCollection_(SpreadsheetApp.getActiveSpreadsheet(), COLLECTION_SHEETS.customLessons);
  var lesson = list.filter(function (l) { return l.id === lessonId; })[0];
  if (!lesson) throw new Error('Bài học không tồn tại hoặc đã bị gỡ.');
  var pub = JSON.parse(JSON.stringify(lesson));
  pub.leaderboard = (pub.leaderboard || []).slice().sort(sortLeaderboardEntries_);
  pub.sourceRefs = pub.sourceRefs || [];
  return pub;
}
