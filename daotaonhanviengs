}

// ============ 2. KHỞI TẠO DATABASE (cấu trúc mới, theo dòng) ============
function initDatabase_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  ensureCollectionSheet_(ss, SHEET_SINGLETONS, ['key', 'json']);
  ensureCollectionSheet_(ss, SHEET_WEEKS, ['id', 'title']);
  ensureCollectionSheet_(ss, SHEET_LESSONS, ['id', 'weekId', 'json']);
  for (var k in COLLECTION_SHEETS) {
    ensureCollectionSheet_(ss, COLLECTION_SHEETS[k], ['id', 'json']);
  }

  var shNV = ss.getSheetByName(SHEET_NHANVIEN);
  if (!shNV) {
    shNV = ss.insertSheet(SHEET_NHANVIEN);
    shNV.appendRow(['SĐT', 'Họ tên', 'Vai trò', 'MatKhauHash', 'NgàyĐăngKý', 'ĐiểmTíchLũy', 'StreakHienTai', 'StreakDaiNhat', 'NgayHoatDongCuoi']);
  }
  // v5.2: LUÔN ép cột SĐT (cột A) về định dạng văn bản mỗi lần khởi tạo app -> tránh mất số 0 đầu
  try { shNV.getRange('A2:A' + Math.max(shNV.getMaxRows(), 1000)).setNumberFormat('@'); } catch (e) {}
  ensureStreakColumns_(shNV);
  var shTD = ss.getSheetByName(SHEET_TIENDO);
  if (!shTD) {
    shTD = ss.insertSheet(SHEET_TIENDO);
    shTD.appendRow(['SĐT', 'DayID', 'Điểm đúng', 'Tổng câu', 'Đạt', 'Thời gian', 'ThoiGianLamBai']);
  }
  ensureDurationColumn_(shTD);
  ensureCollectionSheet_(ss, SHEET_DUELS, ['id', 'json']);

  var props = PropertiesService.getScriptProperties();
  if (!props.getProperty(ADMIN_PW_KEY)) props.setProperty(ADMIN_PW_KEY, ADMIN_PW_DEFAULT);

  migrateLegacyAppDataIfNeeded_(ss);
  seedIfEmpty_(ss);
}

function ensureCollectionSheet_(ss, name, headers) {
  var sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.appendRow(headers);
    try { sh.hideSheet(); } catch (err) {}
  }
  return sh;
}

// v5.2: đảm bảo sheet NhanVien luôn có đủ 3 cột Streak (thêm vào cuối, KHÔNG đụng cột cũ)
function ensureStreakColumns_(shNV) {
  var lastCol = shNV.getLastColumn();
  if (lastCol < 9) {
    shNV.getRange(1, 7, 1, 3).setValues([['StreakHienTai', 'StreakDaiNhat', 'NgayHoatDongCuoi']]);
    var lastRow = shNV.getLastRow();
    if (lastRow > 1) {
      var existing = shNV.getRange(2, 7, lastRow - 1, 3).getValues();
      for (var i = 0; i < existing.length; i++) {
        if (!existing[i][0]) existing[i][0] = 0;
        if (!existing[i][1]) existing[i][1] = 0;
      }
      shNV.getRange(2, 7, lastRow - 1, 3).setValues(existing);
    }
  }
}
function ensureDurationColumn_(shTD) {
  var lastCol = shTD.getLastColumn();
  if (lastCol < 7) {
    shTD.getRange(1, 7).setValue('ThoiGianLamBai');
  }
}
function submitDayQuiz(phoneRaw, dayId, correctCount, totalCount, durationSec) {
  var phone = normalizePhone_(phoneRaw);
  if (!validPhone_(phone)) throw new Error('Vui lòng đăng nhập lại.');
  var passed = correctCount === totalCount && totalCount > 0;
  var streakInfo = touchStreak_(phone);
  var dur = Number(durationSec) || 0;

  var shTD = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_TIENDO);
  ensureDurationColumn_(shTD);
  var data = shTD.getDataRange().getValues();
  var existingRow = -1, alreadyPassed = false;
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][0]) === phone && data[i][1] === dayId) {
      existingRow = i + 1;
      alreadyPassed = (data[i][4] === true || data[i][4] === 'TRUE');
      break;
    }
  }

  var newPoints = null;
  if (existingRow === -1) {
    shTD.appendRow([phone, dayId, correctCount, totalCount, passed, new Date(), dur]);
  } else {
    shTD.getRange(existingRow, 3, 1, 5).setValues([[correctCount, totalCount, passed, new Date(), dur]]);
  }

  if (passed && !alreadyPassed) {
    var shNV = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NHANVIEN);
    var nvRow = findEmployeeRow_(shNV, phone);
    if (nvRow !== -1) {
      var cur = shNV.getRange(nvRow, 6).getValue() || 0;
      newPoints = cur + correctCount * 10;
      shNV.getRange(nvRow, 6).setValue(newPoints);
    }
  } else {
    var shNV2 = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NHANVIEN);
    var nvRow2 = findEmployeeRow_(shNV2, phone);
    newPoints = nvRow2 !== -1 ? shNV2.getRange(nvRow2, 6).getValue() : 0;
  }

  return { ok: true, passed: passed, points: newPoints, streak: streakInfo.streak, bestStreak: streakInfo.best };
}

// ---- Di chuyển dữ liệu cũ (1 cell JSON, sheet "AppData" v2.0) sang cấu trúc mới ----
function migrateLegacyAppDataIfNeeded_(ss) {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty('MIGRATED_V3')) return;

  var oldSh = ss.getSheetByName(SHEET_APPDATA_OLD);
  if (oldSh) {
    var raw = oldSh.getRange('A2').getValue();
    var data = {};
    try { data = JSON.parse(raw); } catch (err) { data = {}; }

    if (data.companyIntro) writeSingleton_(ss, 'companyIntro', data.companyIntro);
    if (data.productStandards) writeSingleton_(ss, 'productStandards', data.productStandards);
    if (data.kpi) writeSingleton_(ss, 'kpi', data.kpi);
    if (data.storeEval) writeSingleton_(ss, 'storeEval', data.storeEval);

    for (var key in COLLECTION_SHEETS) {
      if (data[key] && data[key].length) writeCollection_(ss, COLLECTION_SHEETS[key], data[key]);
    }
    if (data.weeks && data.weeks.length) writeWeeks_(ss, data.weeks);

    try {
      oldSh.hideSheet();
      oldSh.setName('AppData_OLD_BACKUP_v2');
    } catch (err) {}
  }
  props.setProperty('MIGRATED_V3', 'true');
}

// Nếu vẫn trống sau migrate (cài đặt hoàn toàn mới) -> nạp dữ liệu mẫu
function seedIfEmpty_(ss) {
  var seed = getSeedData_();
  if (!readSingleton_(ss, 'companyIntro')) writeSingleton_(ss, 'companyIntro', seed.companyIntro);
  if (!readSingleton_(ss, 'productStandards')) writeSingleton_(ss, 'productStandards', seed.productStandards);
  if (!readSingleton_(ss, 'kpi')) writeSingleton_(ss, 'kpi', seed.kpi);
  if (!readSingleton_(ss, 'storeEval')) writeSingleton_(ss, 'storeEval', seed.storeEval);
  if (!readSingleton_(ss, 'qlchInfo') && seed.qlchInfo) writeSingleton_(ss, 'qlchInfo', seed.qlchInfo);
  for (var key in COLLECTION_SHEETS) {
    if (key === 'customLessons') continue;
    var sh = ss.getSheetByName(COLLECTION_SHEETS[key]);
    if (sh.getLastRow() < 2 && seed[key] && seed[key].length) writeCollection_(ss, COLLECTION_SHEETS[key], seed[key]);
  }
  var wsh = ss.getSheetByName(SHEET_WEEKS);
  if (wsh.getLastRow() < 2 && seed.weeks && seed.weeks.length) writeWeeks_(ss, seed.weeks);
}

// ============ 3. ĐỌC / GHI DỮ LIỆU (theo dòng, không còn giới hạn 1 cell) ============
function readSingleton_(ss, key) {
  var sh = ss.getSheetByName(SHEET_SINGLETONS);
  var data = sh.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (data[i][0] === key) {
      try { return JSON.parse(data[i][1]); } catch (e) { return null; }
    }
  }
  return null;
}
function writeSingleton_(ss, key, obj) {
  var sh = ss.getSheetByName(SHEET_SINGLETONS);
  var data = sh.getDataRange().getValues();
  var json = JSON.stringify(obj);
  for (var i = 1; i < data.length; i++) {
    if (data[i][0] === key) { sh.getRange(i + 1, 2).setValue(json); return; }
  }
  sh.appendRow([key, json]);
}
function readCollection_(ss, sheetName) {
  var sh = ss.getSheetByName(sheetName);
  var data = sh.getDataRange().getValues();
  var out = [];
  for (var i = 1; i < data.length; i++) {
    if (!data[i][0]) continue;
    var item;
    try { item = JSON.parse(data[i][1]); } catch (e) { item = {}; }
    item.id = data[i][0];
    out.push(item);
  }
  return out;
}
function writeCollection_(ss, sheetName, items) {
  var sh = ss.getSheetByName(sheetName);
  var lastRow = sh.getLastRow();
  if (lastRow > 1) sh.getRange(2, 1, lastRow - 1, 2).clearContent();
  var rows = items.map(function (it) {
    var copy = {};
    for (var k in it) { if (k !== 'id') copy[k] = it[k]; }
    return [it.id, JSON.stringify(copy)];
  });
  if (rows.length) sh.getRange(2, 1, rows.length, 2).setValues(rows);
}
function readWeeks_(ss) {
  var wsh = ss.getSheetByName(SHEET_WEEKS);
  var wdata = wsh.getDataRange().getValues();
  var lsh = ss.getSheetByName(SHEET_LESSONS);
  var ldata = lsh.getDataRange().getValues();
  var weeks = [];
  for (var i = 1; i < wdata.length; i++) {
    if (!wdata[i][0]) continue;
    weeks.push({ id: wdata[i][0], title: wdata[i][1], lessons: [], audience: wdata[i][2] || 'all' });
  }
  for (var j = 1; j < ldata.length; j++) {
    if (!ldata[j][0]) continue;
    var lesson;
    try { lesson = JSON.parse(ldata[j][2]); } catch (e) { lesson = {}; }
    lesson.id = ldata[j][0];
    var week = weeks.filter(function (w) { return w.id === ldata[j][1]; })[0];
    if (week) week.lessons.push(lesson);
  }
  return weeks;
}
function writeWeeks_(ss, weeks) {
  var wsh = ss.getSheetByName(SHEET_WEEKS);
  var lsh = ss.getSheetByName(SHEET_LESSONS);
  var wLast = wsh.getLastRow();
  if (wLast > 1) wsh.getRange(2, 1, wLast - 1, 3).clearContent();
  var lLast = lsh.getLastRow();
  if (lLast > 1) lsh.getRange(2, 1, lLast - 1, 3).clearContent();

  var wRows = [], lRows = [];
  weeks.forEach(function (w) {
    wRows.push([w.id, w.title, w.audience || 'all']);
    (w.lessons || []).forEach(function (l) {
      var copy = {};
      for (var k in l) { if (k !== 'id') copy[k] = l[k]; }
      lRows.push([l.id, w.id, JSON.stringify(copy)]);
    });
  });
  if (wRows.length) wsh.getRange(2, 1, wRows.length, 3).setValues(wRows);
  if (lRows.length) lsh.getRange(2, 1, lRows.length, 3).setValues(lRows);
}

// ============ 4. API CHO INDEX.HTML (giữ nguyên chữ ký hàm cũ) ============
function getAppData() {
  initDatabase_();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var out = {};
  out.companyIntro = readSingleton_(ss, 'companyIntro');
  out.productStandards = readSingleton_(ss, 'productStandards');
  out.kpi = readSingleton_(ss, 'kpi');
  out.storeEval = readSingleton_(ss, 'storeEval');
  for (var key in COLLECTION_SHEETS) {
    if (key === 'customLessons') continue; // tải riêng qua getCustomLesson/listCustomLessons, không nạp chung (payload nhẹ)
    out[key] = readCollection_(ss, COLLECTION_SHEETS[key]);
  }
  out.qlchInfo = readSingleton_(ss, 'qlchInfo');
  out.weeks = readWeeks_(ss);
  return out;
}

function saveAppData(password, key, value) {
  checkPassword_(password);
  if (DATA_KEYS.indexOf(key) === -1) throw new Error('Khóa dữ liệu không hợp lệ: ' + key);
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  if (SINGLETON_KEYS.indexOf(key) !== -1) {
    writeSingleton_(ss, key, value);
  } else if (key === 'weeks') {
    writeWeeks_(ss, value);
  } else {
    writeCollection_(ss, COLLECTION_SHEETS[key], value);
  }
  return { ok: true };
}

// ============ 5. XÁC THỰC ADMIN ============
function checkPassword_(password) {
  var props = PropertiesService.getScriptProperties();
  var real = props.getProperty(ADMIN_PW_KEY) || ADMIN_PW_DEFAULT;
  if (!password || password !== real) {
    throw new Error('Mật khẩu quản trị không đúng.');
  }
  return true;
}

function changePassword(oldPassword, newPassword) {
  checkPassword_(oldPassword);
  if (!newPassword || newPassword.length < 4) {
    throw new Error('Mật khẩu mới phải có ít nhất 4 ký tự.');
  }
  PropertiesService.getScriptProperties().setProperty(ADMIN_PW_KEY, newPassword);
  return { ok: true };
}

// ============ 5B. UPLOAD ẢNH TRỰC TIẾP (thay cho dán link URL) ============
// Ảnh được lưu vào một thư mục Google Drive riêng của app, đặt quyền
// "Anyone with the link can view", trả về link ảnh dùng trực tiếp trong <img>.
var IMAGE_FOLDER_NAME = '9Sach_AppImages';
function getOrCreateImageFolder_() {
  var props = PropertiesService.getScriptProperties();
  var folderId = props.getProperty('IMAGE_FOLDER_ID');
  if (folderId) {
    try { return DriveApp.getFolderById(folderId); } catch (e) { /* folder id stale, recreate below */ }
  }
  var folders = DriveApp.getFoldersByName(IMAGE_FOLDER_NAME);
  var folder = folders.hasNext() ? folders.next() : DriveApp.createFolder(IMAGE_FOLDER_NAME);
  try { folder.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (e) {}
  props.setProperty('IMAGE_FOLDER_ID', folder.getId());
  return folder;
}
function uploadImage(password, base64Data, filename, mimeType) {
  checkPassword_(password);
  if (!base64Data) throw new Error('Không có dữ liệu ảnh.');
  var folder = getOrCreateImageFolder_();
  var safeMime = mimeType || 'image/jpeg';
  var bytes = Utilities.base64Decode(base64Data);
  var blob = Utilities.newBlob(bytes, safeMime, filename || ('image_' + Date.now()));
  var file = folder.createFile(blob);
  try { file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (e) {}
  var fileId = file.getId();
  // Link dạng lh3.googleusercontent.com hiển thị trực tiếp ảnh (không qua trang xem trước của Drive)
  var url = 'https://lh3.googleusercontent.com/d/' + fileId;
  return { ok: true, url: url, fileId: fileId };
}

// ============ 6. ĐĂNG KÝ / ĐĂNG NHẬP NHÂN VIÊN ============
function normalizePhone_(phone) {
  if (!phone) return '';
  var p = String(phone).trim().replace(/[\s.\-()]/g, '');
  if (p.indexOf('+84') === 0) p = '0' + p.substring(3);
  else if (p.indexOf('84') === 0 && p.length === 11) p = '0' + p.substring(2);
  return p;
}
function validPhone_(phone) {
  return /^0\d{9}$/.test(phone);
}
function hashPw_(pw) {
  var digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, pw + '::9sach::salt');
  return digest.map(function (b) { return (b < 0 ? b + 256 : b).toString(16).padStart(2, '0'); }).join('');
}
function findEmployeeRow_(sh, phone) {
  var data = sh.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][0]) === phone) return i + 1;
  }
  return -1;
}
function registerEmployee(phoneRaw, name, password) {
  var phone = normalizePhone_(phoneRaw);
  if (!validPhone_(phone)) throw new Error('Số điện thoại không hợp lệ. Vui lòng nhập đúng định dạng 0xxxxxxxxx.');
  if (!name || !name.trim()) throw new Error('Vui lòng nhập họ tên.');
  if (!password || password.length < 4) throw new Error('Mật khẩu phải có ít nhất 4 ký tự.');

  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NHANVIEN);
  if (findEmployeeRow_(sh, phone) !== -1) {
    throw new Error('Số điện thoại này đã được đăng ký. Vui lòng đăng nhập.');
  }
  // v5.2: ép định dạng văn bản cho ô SĐT NGAY TRƯỚC khi ghi -> không bị Sheets tự rút số 0 đầu
  var newRow = sh.getLastRow() + 1;
  sh.getRange(newRow, 1).setNumberFormat('@').setValue(phone);
  sh.getRange(newRow, 2, 1, 5).setValues([[name.trim(), 'NhanVien', hashPw_(password), new Date(), 0]]);
  var st0 = touchStreak_(phone);
  return { ok: true, phone: phone, name: name.trim(), role: 'NhanVien', points: 0, streak: st0.streak, bestStreak: st0.best };
}
function loginEmployee(phoneRaw, password) {
  var phone = normalizePhone_(phoneRaw);
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NHANVIEN);
  var row = findEmployeeRow_(sh, phone);
  if (row === -1) throw new Error('Số điện thoại chưa được đăng ký.');
  var rowData = sh.getRange(row, 1, 1, 6).getValues()[0];
  if (rowData[3] !== hashPw_(password)) throw new Error('Mật khẩu không đúng.');
  var st = touchStreak_(phone);
  return { ok: true, phone: phone, name: rowData[1], role: rowData[2], points: rowData[5], streak: st.streak, bestStreak: st.best };
}

// v5.2: cập nhật streak "học liên tục N ngày" — gọi mỗi khi đăng nhập / làm quiz / chơi game
function touchStreak_(phone) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NHANVIEN);
  var row = findEmployeeRow_(sh, phone);
  if (row === -1) return { streak: 0, best: 0 };
  var vals = sh.getRange(row, 7, 1, 3).getValues()[0];
  var streak = Number(vals[0]) || 0;
  var best = Number(vals[1]) || 0;
  var lastStr = vals[2] ? String(vals[2]) : '';
  var tz = Session.getScriptTimeZone() || 'Asia/Ho_Chi_Minh';
  var todayStr = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
  if (lastStr !== todayStr) {
    var y = new Date(); y.setDate(y.getDate() - 1);
    var yStr = Utilities.formatDate(y, tz, 'yyyy-MM-dd');
    streak = (lastStr === yStr) ? streak + 1 : 1;
    if (streak > best) best = streak;
    sh.getRange(row, 7, 1, 3).setValues([[streak, best, todayStr]]);
  }
  return { streak: streak, best: best };
}

