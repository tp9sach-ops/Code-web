/* ---- Rải đều 1 bộ câu hỏi vào .quiz của từng item trong 1 sheet dạng
   collection (SOP / Hướng dẫn thao tác / Kịch bản / Kỹ năng / QLCH /
   B2B...). Nếu truyền categoryFilterList thì ưu tiên rải vào các item
   đúng category đó trước (VD: chỉ rải vào SOP "Tác phong" / "Hành vi
   nghiêm cấm"), nếu không có item nào khớp thì rải đều toàn bộ sheet.
   An toàn: chỉ thêm câu hỏi có nội dung CHƯA tồn tại trong .quiz của
   item đó. */
function distributeQuizToCollection_(ss, sheetName, questions, categoryFilterList){
  var items = readCollection_(ss, sheetName);
  if(!items.length) return 0;
  var pool = items;
  if(categoryFilterList && categoryFilterList.length){
    var filtered = items.filter(function(it){ return categoryFilterList.indexOf(it.category) !== -1; });
    if(filtered.length) pool = filtered;
  }
  var added = 0;
  questions.forEach(function(q, i){
    var target = pool[i % pool.length];
    target.quiz = target.quiz || [];
    var already = target.quiz.some(function(e){ return e.question === q.question; });
    if(!already){ target.quiz.push(q); added++; }
  });
  writeCollection_(ss, sheetName, items);
  return added;
}

/* ---- Rải đều 1 bộ câu hỏi vào .quiz của các "Ngày" (lessons) theo
   danh sách dayIds được chỉ định, xoay vòng round-robin. */
function distributeQuizToDays_(ss, dayIds, questions){
  var weeks = readWeeks_(ss);
  var added = 0;
  questions.forEach(function(q, i){
    var dayId = dayIds[i % dayIds.length];
    weeks.forEach(function(w){
      if(w.id !== dayId) return;
      w.lessons.forEach(function(l){
        l.quiz = l.quiz || [];
        var already = l.quiz.some(function(e){ return e.question === q.question; });
        if(!already){ l.quiz.push(q); added++; }
      });
    });
  });
  writeWeeks_(ss, weeks);
  return added;
}

