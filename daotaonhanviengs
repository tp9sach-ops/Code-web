}

// ============ 8. MINI-GAME "GỐI NHẢY ĐÁ" ============
function getAllQuizQuestions() {
  var data = getAppData();
  var pool = [];
  (data.weeks || []).forEach(function (week) {
    (week.lessons || []).forEach(function (lesson) {
      (lesson.quiz || []).forEach(function (q) {
        if (q && q.question && Array.isArray(q.options) && q.options.length >= 2) {
          pool.push({ question: q.question, options: q.options, answerIndex: q.answerIndex });
        }
      });
    });
  });
  // v5.1: tự động sinh thêm câu hỏi từ dữ liệu Quy định (SOP) để kho câu hỏi luôn dồi dào
  // mà không cần Admin tự soạn Quiz cho từng bài học.
  var bySopCat = {};
  (data.sop || []).forEach(function (s) {
    if (!s.situation || !s.solution) return;
    if (!bySopCat[s.category]) bySopCat[s.category] = [];
    bySopCat[s.category].push(s);
  });
  Object.keys(bySopCat).forEach(function (cat) {
    var items = bySopCat[cat];
    if (items.length < 2) return;
    items.forEach(function (s) {
      var distractors = items.filter(function (x) { return x.id !== s.id; })
        .map(function (x) { return x.solution; })
        .sort(function () { return Math.random() - 0.5; }).slice(0, 3);
      var options = distractors.concat([s.solution]).sort(function () { return Math.random() - 0.5; });
      pool.push({ question: 'Tình huống: "' + s.situation + '" — Cách xử lý ĐÚNG là gì?', options: options, answerIndex: options.indexOf(s.solution) });
    });
  });
  return pool;
}

function submitGameScore(phoneRaw, score) {
