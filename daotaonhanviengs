/* ---- Gắn trực tiếp vào bộ dữ liệu mẫu WEEK0_ONBOARDING (áp dụng ngay
   cho cài đặt hoàn toàn mới / sheet còn trống). Đoạn này chạy mỗi lần
   file Code.gs được nạp, nên luôn tự bổ sung nếu lesson.quiz còn thiếu
   những câu hỏi này (so khớp theo đúng câu hỏi, không lặp). */
(function attachCuratedQuizToSeed_(){
  var map = {
    W00D1: CURATED_QUIZ_W00D1, W00D2: CURATED_QUIZ_W00D2, W00D3: CURATED_QUIZ_W00D3,
    W00D4: CURATED_QUIZ_W00D4, W00D5: CURATED_QUIZ_W00D5, W00D6: CURATED_QUIZ_W00D6
  };
  (WEEK0_ONBOARDING.lessons || []).forEach(function(l){
    var extra = map[l.id];
    if(!extra) return;
    l.quiz = l.quiz || [];
    var have = {};
    l.quiz.forEach(function(q){ have[q.question] = true; });
    extra.forEach(function(q){ if(!have[q.question]){ l.quiz.push(q); have[q.question] = true; } });
  });
})();

/* ---- Gộp câu hỏi vào 1 bài học đã tồn tại trên Sheet (theo lessonId,
   KHÔNG theo weekId — vẫn đúng dù bạn đã chạy restructureWeeksToDays_v7
   đổi "Tuần" thành "Ngày", vì lessonId không đổi). An toàn: chỉ thêm câu
   hỏi có nội dung CHƯA tồn tại, không đụng câu hỏi cũ / câu tự sửa. */
function mergeQuizIntoLesson_(ss, lessonId, curatedQuiz){
  var weeks = readWeeks_(ss);
  var found = false, added = 0;
  weeks.forEach(function(w){
    w.lessons.forEach(function(l){
      if(l.id === lessonId){
        found = true;
        l.quiz = l.quiz || [];
        var have = {};
        l.quiz.forEach(function(q){ have[q.question] = true; });
        curatedQuiz.forEach(function(q){
          if(!have[q.question]){ l.quiz.push(q); have[q.question] = true; added++; }
        });
      }
    });
  });
  if(found) writeWeeks_(ss, weeks);
  return added;
}

function addExpandedContent_v9(){
  initDatabase_();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
