/*************************************************************
 * ============ 11I. CHUYỂN LỘ TRÌNH "TUẦN" -> "NGÀY" (v7) ============
 * Gộp toàn bộ Tuần 1..5 thành chuỗi "Ngày 1, Ngày 2..." nối tiếp, mỗi
 * Ngày = 1 bài học cũ (giữ nguyên ID -> không mất tiến độ/điểm học viên
 * vì bảng TienDoHocTap tra theo lessonId, không theo weekId).
 * NÊN SAO LƯU (File > Make a copy) TRƯỚC KHI CHẠY LẦN ĐẦU.
 * CHẠY: chọn hàm "restructureWeeksToDays_v7" trong dropdown -> Run.
 *************************************************************/
function restructureWeeksToDays_v7() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var weeks = readWeeks_(ss);
  var dayNum = 0;
  var newWeeks = [];
  weeks.forEach(function (w) {
    (w.lessons || []).forEach(function (lesson) {
      dayNum++;
      var cleanTitle = String(lesson.title || '').replace(/^\s*(Ngày|Tuần)\s*\d+\s*[:\-–]?\s*/i, '').trim();
      var newLesson = Object.assign({}, lesson, { title: 'Ngày ' + dayNum + ': ' + cleanTitle });
      newWeeks.push({
        id: 'D' + String(dayNum).padStart(2, '0'),
        title: 'Ngày ' + dayNum,
        audience: w.audience || 'all',
        lessons: [newLesson]
      });
    });
  });
  writeWeeks_(ss, newWeeks);
  Logger.log('Đã chuyển ' + dayNum + ' bài học thành ' + dayNum + ' "Ngày" liên tục.');
  return { totalDays: dayNum };
}
// v7: tạo bài học tự tạo TỪ DỮ LIỆU ĐÃ DỰNG SẴN Ở TRÌNH DUYỆT — nhanh hơn nhiều
// vì không phải đọc lại toàn bộ getAppData() trên server.
function adminCreateCustomLessonFromData(password, title, contentBlocks, quiz, sourceRefs) {
  checkPassword_(password);
  if (!title || !String(title).trim()) throw new Error('Vui lòng nhập tên bài học.');
  if (!contentBlocks || !contentBlocks.length) throw new Error('Vui lòng chọn ít nhất 1 mục kiến thức.');
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var lesson = {
    id: genLessonId_(), title: title, createdAt: new Date().toISOString(),
    content: contentBlocks, quiz: quiz || [], active: true, leaderboard: [],
    sourceRefs: sourceRefs || []
  };
  var list = readCollection_(ss, COLLECTION_SHEETS.customLessons);
  list.push(lesson);
  writeCollection_(ss, COLLECTION_SHEETS.customLessons, list);
  return lesson;
}
