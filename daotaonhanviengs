// ============ 9B. "ĐẤU ĐÔI" — QUIZ ĐỐI KHÁNG TRỰC TIẾP 2 NGƯỜI ============
// Không có websocket trong Apps Script nên dùng cơ chế polling: mỗi phòng đấu
// là 1 dòng JSON trong sheet "Duels", client gọi getDuelState() lặp lại mỗi
// 1.5-2 giây để đồng bộ điểm/câu hỏi của cả 2 người theo thời gian gần-thực.
function readDuel_(id) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_DUELS);
  var data = sh.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (data[i][0] === id) { try { return JSON.parse(data[i][1]); } catch (e) { return null; } }
  }
  return null;
}
function writeDuel_(duel) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_DUELS);
  var data = sh.getDataRange().getValues();
  duel.updatedAt = new Date().toISOString();
  for (var i = 1; i < data.length; i++) {
    if (data[i][0] === duel.id) { sh.getRange(i + 1, 2).setValue(JSON.stringify(duel)); return; }
  }
  sh.appendRow([duel.id, JSON.stringify(duel)]);
}
function findDuelByCode_(code) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_DUELS);
  var data = sh.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    try {
      var d = JSON.parse(data[i][1]);
      if (d.code === code && d.status === 'waiting') return d;
    } catch (e) {}
  }
  return null;
}
function shuffleOptionsWithAnswer_(q) {
  var idxArr = q.options.map(function (_, i) { return i; });
  for (var i = idxArr.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = idxArr[i]; idxArr[i] = idxArr[j]; idxArr[j] = t;
  }
  var newOptions = idxArr.map(function (i) { return q.options[i]; });
  return { question: q.question, options: newOptions, answerIndex: idxArr.indexOf(q.answerIndex) };
}
function pickDuelQuestions_(n) {
  var pool = getAllQuizQuestions().filter(function (q) { return q.question && q.options && q.options.length >= 2; });
  pool = pool.sort(function () { return Math.random() - 0.5; });
  return pool.slice(0, n).map(shuffleOptionsWithAnswer_);
}
function createDuel(phoneRaw, name) {
  var phone = normalizePhone_(phoneRaw);
  var code = String(Math.floor(100000 + Math.random() * 900000));
  var duel = {
    id: 'DUEL' + Date.now(),
    code: code,
    status: 'waiting',
    questions: pickDuelQuestions_(10),
    currentIndex: 0,
    p1: { phone: phone, name: name, score: 0, answeredIndex: -1, lastCorrect: null },
    p2: null,
    createdAt: new Date().toISOString()
  };
  writeDuel_(duel);
  return duel;
}
function joinDuel(code, phoneRaw, name) {
  var phone = normalizePhone_(phoneRaw);
  var duel = findDuelByCode_(code);
  if (!duel) throw new Error('Không tìm thấy phòng đấu với mã này, hoặc phòng đã có đủ người / đã bắt đầu.');
  if (duel.p1.phone === phone) throw new Error('Bạn không thể tự đấu với chính mình.');
  duel.p2 = { phone: phone, name: name, score: 0, answeredIndex: -1, lastCorrect: null };
  duel.status = 'playing';
  writeDuel_(duel);
  return duel;
}
function getDuelState(duelId) {
  var duel = readDuel_(duelId);
  if (!duel) throw new Error('Phòng đấu không tồn tại hoặc đã kết thúc.');
  return duel;
}
function submitDuelAnswer(duelId, phoneRaw, qIndex, selectedIndex) {
  var phone = normalizePhone_(phoneRaw);
  var duel = readDuel_(duelId);
  if (!duel) throw new Error('Phòng đấu không tồn tại.');
  if (duel.status !== 'playing') return duel;
  if (qIndex !== duel.currentIndex) return duel; // câu đã bị đổi (do đối thủ đã qua câu mới) -> bỏ qua
  var q = duel.questions[qIndex];
  var isCorrect = selectedIndex === q.answerIndex;
  var who = (duel.p1.phone === phone) ? 'p1' : (duel.p2 && duel.p2.phone === phone) ? 'p2' : null;
  if (!who) throw new Error('Bạn không thuộc phòng đấu này.');
  if (duel[who].answeredIndex !== qIndex) {
    duel[who].answeredIndex = qIndex;
    duel[who].lastCorrect = isCorrect;
    if (isCorrect) duel[who].score += 10;
  }
  var bothAnswered = duel.p1.answeredIndex === qIndex && duel.p2 && duel.p2.answeredIndex === qIndex;
  if (bothAnswered) {
    if (duel.currentIndex >= duel.questions.length - 1) duel.status = 'finished';
    else duel.currentIndex++;
  }
  writeDuel_(duel);
  return duel;
}
function forceAdvanceDuel(duelId, qIndex) {
  // Dùng khi 1 người hết giờ chưa trả lời -> vẫn cho qua câu để phòng không bị treo
  var duel = readDuel_(duelId);
  if (!duel || duel.status !== 'playing' || qIndex !== duel.currentIndex) return duel;
  if (duel.p1.answeredIndex !== qIndex) duel.p1.answeredIndex = qIndex;
  if (duel.p2 && duel.p2.answeredIndex !== qIndex) duel.p2.answeredIndex = qIndex;
  if (duel.currentIndex >= duel.questions.length - 1) duel.status = 'finished';
  else duel.currentIndex++;
  writeDuel_(duel);
  return duel;
}

