/* ============ HÀM CHẠY CHÍNH — CHỌN "addExpandedContent_v12" RỒI RUN ============ */
function addExpandedContent_v12() {
  initDatabase_();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var added = {};

  // A) Khách hàng sỉ hiện hữu — CHỈ THÊM nếu sheet WholesaleCustomers còn trống
  //    (tránh ghi đè nếu bạn đã từng nhập tay dữ liệu khách sỉ trước đó)
  if (COLLECTION_SHEETS.wholesaleCustomers) {
    var existingWC = readCollection_(ss, COLLECTION_SHEETS.wholesaleCustomers);
    if (!existingWC.length) {
      writeCollection_(ss, COLLECTION_SHEETS.wholesaleCustomers, SEED_WHOLESALE_CUSTOMERS_V12);
      added.wholesaleCustomers = SEED_WHOLESALE_CUSTOMERS_V12.length;
    } else {
      added.wholesaleCustomers = appendItemsIfMissing_(ss, COLLECTION_SHEETS.wholesaleCustomers, SEED_WHOLESALE_CUSTOMERS_V12);
    }
  } else {
    added.wholesaleCustomers = 'BỎ QUA — bạn CHƯA thêm "wholesaleCustomers: \'WholesaleCustomers\'" vào COLLECTION_SHEETS (xem BƯỚC 1 ở đầu file).';
  }

  // B) Kiến thức giá thành B2B (đơn giá trước thuế)
  added.operationGuides = appendItemsIfMissing_(ss, COLLECTION_SHEETS.operationGuides, EXTRA_GUIDES_V12);

  // C) Sản phẩm theo yêu cầu
  added.productLines = appendItemsIfMissing_(ss, COLLECTION_SHEETS.productLines, EXTRA_PRODUCTLINES_V12);

  // D) Sửa lại B2B01 / B2B02 cho xuống dòng rõ ràng
  upsertItems_(ss, COLLECTION_SHEETS.b2bTopics, UPDATE_B2B_TOPICS_V12);
  added.b2bTopics_reformatted = UPDATE_B2B_TOPICS_V12.length;

  Logger.log(JSON.stringify(added));
  return added;
}
