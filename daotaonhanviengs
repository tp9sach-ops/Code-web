/*************************************************************
 * ============ 11H. CẬP NHẬT v6.1 — SỬA GIÁ BÁNH DẺO THEO ĐÚNG MENU
 * BÁN LẺ CHÍNH THỨC (ảnh menu đính kèm) + bổ sung thông tin bảo quản
 * bánh trứng muối. Bánh sầu riêng dẻo mua lẻ KHÔNG giảm giá theo số
 * lượng cái — mà bán theo COMBO HỘP (2 bánh/185k, 4 bánh/360k).
 * AN TOÀN: chỉ GHI ĐÈ các item P16/P17/PL08/SOP54 có sẵn (đã lỡ tạo từ
 * bản v6.0 cũ với số liệu tạm) và THÊM các item mới P16B/P16C/SOP54B
 * nếu còn thiếu. CHẠY 1 LẦN: chọn hàm "fixProductData_v6_1" -> Run.
 *************************************************************/
function upsertItems_(ss, sheetName, items) {
  var existing = readCollection_(ss, sheetName);
  var byId = {};
  existing.forEach(function (it) { byId[it.id] = it; });
  items.forEach(function (it) { byId[it.id] = it; });
  var merged = [];
  var seen = {};
  existing.forEach(function (it) { if (byId[it.id] && !seen[it.id]) { merged.push(byId[it.id]); seen[it.id] = true; } });
  items.forEach(function (it) { if (!seen[it.id]) { merged.push(byId[it.id]); seen[it.id] = true; } });
  writeCollection_(ss, sheetName, merged);
}
function fixProductData_v6_1() {
  initDatabase_();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  upsertItems_(ss, COLLECTION_SHEETS.products, EXTRA_PRODUCTS_V6);
  upsertItems_(ss, COLLECTION_SHEETS.productLines, EXTRA_PRODUCTLINES_V6);
  upsertItems_(ss, COLLECTION_SHEETS.sop, EXTRA_SOP_V6);
  Logger.log('Đã cập nhật lại giá & bảo quản bánh dẻo theo menu chính thức.');
}

