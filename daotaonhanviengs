function sortLeaderboardEntries_(a, b){
  if((b.score||0) !== (a.score||0)) return (b.score||0) - (a.score||0);
  var at = (typeof a.timeSeconds === 'number' && a.timeSeconds > 0) ? a.timeSeconds : Infinity;
  var bt = (typeof b.timeSeconds === 'number' && b.timeSeconds > 0) ? b.timeSeconds : Infinity;
  return at - bt;
}
function stripPreservativeClaim_(text){
  if(!text) return text;
  var out = String(text);
  out = out.replace(/,?\s*không\s+dùng\s+chất\s+bảo\s+quản\.?/gi, '');
  out = out.replace(/,?\s*không\s+chất\s+bảo\s+quản\.?/gi, '');
  out = out.replace(/[ \t]{2,}/g, ' ').replace(/\s+([\.,])/g, '$1').trim();
  return out;
}
/* ---- Dọn dẹp Ngày 1-6: nội dung đầy đủ (câu hỏi không bị cắt, số lượng
   nhiều) đang bị gắn nhầm weekId D12-D17 (hiển thị lộn thành "Ngày 12"-
   "Ngày 17") thay vì đúng chỗ của nó là "Ngày 1"-"Ngày 6". Hàm này gán lại
   đúng vị trí, XOÁ 6 mục "Ngày 12"-"Ngày 17" dư thừa, và GIỮ NGUYÊN id bài
   học cũ (d1..d6) để không làm mất lịch sử điểm/tiến độ học tập của nhân
   viên đã lưu trong sheet TienDoHocTap (cột DayID tham chiếu theo id này).
   KHÔNG đụng tới "W00" (Lộ trình Hội nhập Thực chiến 7 ngày - dùng riêng)
   và KHÔNG đụng tới Ngày 7-11 (nội dung riêng biệt, không trùng lặp). */
function fixWeek1to6Content_v1(){
  initDatabase_();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var weeks = readWeeks_(ss);
  var mapping = { D12:'D01', D13:'D02', D14:'D03', D15:'D04', D16:'D05', D17:'D06' };
  var report = { replaced: [], removedWeeks: [] };

  for (var oldWeekId in mapping) {
    var newWeekId = mapping[oldWeekId];
    var richWeek = weeks.filter(function(w){ return w.id === oldWeekId; })[0];
    var targetWeek = weeks.filter(function(w){ return w.id === newWeekId; })[0];
    if (!richWeek || !targetWeek || !richWeek.lessons.length) continue;
    var richLesson = richWeek.lessons[0];
    var dayNum = newWeekId.replace('D','').replace(/^0+/, '');
    var cleanTitle = String(richLesson.title||'').replace(/^Ngày\s*\d+(\s*:\s*\d+)?\s*:?\s*/i, '');
    var fixedLesson = JSON.parse(JSON.stringify(richLesson));
    fixedLesson.id = targetWeek.lessons.length ? targetWeek.lessons[0].id : ('d' + dayNum);
    fixedLesson.title = 'Ngày ' + dayNum + ': ' + cleanTitle;
    targetWeek.lessons = [fixedLesson];
    report.replaced.push(newWeekId + ' <- ' + oldWeekId + ' (giữ id: ' + fixedLesson.id + ')');
  }

  weeks = weeks.filter(function(w){
    if (mapping.hasOwnProperty(w.id)) { report.removedWeeks.push(w.id); return false; }
    return true;
  });

  writeWeeks_(ss, weeks);
  Logger.log(JSON.stringify(report));
  return report;
}
function fixRemovePreservativeClaim_v1(){
  initDatabase_();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var report = {};
  var reg = /không\s+(dùng\s+)?chất\s+bảo\s+quản/i;
 
  var lines = readCollection_(ss, COLLECTION_SHEETS.productLines);
  var changedLines = 0;
  lines.forEach(function(p){
    ['sellingNote','ingredients'].forEach(function(f){
      if(p[f] && reg.test(p[f])){ p[f] = stripPreservativeClaim_(p[f]); changedLines++; }
    });
  });
  if(changedLines) writeCollection_(ss, COLLECTION_SHEETS.productLines, lines);
  report.productLines_fields_changed = changedLines;
 
  var sops = readCollection_(ss, COLLECTION_SHEETS.sop);
  var changedSop = 0;
  sops.forEach(function(s){
    ['situation','solution','note'].forEach(function(f){
      if(s[f] && reg.test(s[f])){ s[f] = stripPreservativeClaim_(s[f]); changedSop++; }
    });
  });
  if(changedSop) writeCollection_(ss, COLLECTION_SHEETS.sop, sops);
  report.sop_fields_changed = changedSop;
 
  var lessons = readCollection_(ss, COLLECTION_SHEETS.customLessons);
  var changedLessons = 0;
  lessons.forEach(function(l){
    (l.content||[]).forEach(function(block){
      if(block.body && reg.test(block.body)){ block.body = stripPreservativeClaim_(block.body); changedLessons++; }
      if(block.title && reg.test(block.title)){ block.title = stripPreservativeClaim_(block.title); changedLessons++; }
    });
  });
  if(changedLessons) writeCollection_(ss, COLLECTION_SHEETS.customLessons, lessons);
  report.customLesson_blocks_changed = changedLessons;
 
  Logger.log(JSON.stringify(report));
  return report;
}
