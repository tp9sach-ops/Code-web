/* Âm thanh hiệu ứng — tạo trực tiếp bằng Web Audio API, không cần file/cài thêm.
   Gồm: nhạc nền vui nhộn kịch tính lặp giai điệu 8 nốt khi chơi, tiếng đúng/sai,
   tiếng tích-tắc gấp gáp 5 giây cuối, tiếng chiến thắng, và có thể TẮT TIẾNG. */
var SFX_MUTED = (function(){ try{ return localStorage.getItem('sfx_muted_9sach')==='1'; }catch(e){ return false; } })();
function toggleSfxMuted(){
  SFX_MUTED = !SFX_MUTED;
  try{ localStorage.setItem('sfx_muted_9sach', SFX_MUTED ? '1':'0'); }catch(e){}
  if(SFX_MUTED) SFX.stopBg();
  else if(STATE.gameState && STATE.gameState.alive) SFX.startBg();
  var btn = document.getElementById('sfxMuteBtn');
  if(btn) btn.innerHTML = SFX_MUTED ? '<i class="fa-solid fa-volume-xmark"></i>' : '<i class="fa-solid fa-volume-high"></i>';
}
var SFX = (function(){
  var ctx;
  var bgTimer = null;
  function getCtx(){ if(!ctx){ try{ ctx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ ctx=null; } } return ctx; }
  function tone(freq, dur, type, vol, delay){
    if(SFX_MUTED) return;
    var c = getCtx(); if(!c) return;
    var t0 = c.currentTime + (delay||0);
    var osc = c.createOscillator(); var gain = c.createGain();
    osc.type = type||'sine'; osc.frequency.setValueAtTime(freq, t0);
    gain.gain.setValueAtTime(0, t0);
    gain.gain.linearRampToValueAtTime(vol||0.15, t0+0.02);
    gain.gain.exponentialRampToValueAtTime(0.001, t0+dur);
    osc.connect(gain); gain.connect(c.destination);
    osc.start(t0); osc.stop(t0+dur+0.02);
  }
  // Giai điệu nền vui nhộn, kịch tính kiểu game show — 8 nốt lặp vòng, nhịp nhanh dần khi thời gian gấp
  var BG_MELODY = [392.00, 392.00, 523.25, 493.88, 440.00, 440.00, 587.33, 523.25];
  return {
    click: function(){ tone(700,0.05,'square',0.05,0); },
    correct: function(){ tone(523.25,0.12,'triangle',0.2,0); tone(783.99,0.16,'triangle',0.18,0.1); },
    wrong: function(){ tone(220,0.25,'sawtooth',0.16,0); tone(160,0.3,'sawtooth',0.14,0.12); },
    tick: function(){ tone(880,0.06,'square',0.08,0); },
    win: function(){ tone(523.25,0.12,'triangle',0.2,0); tone(659.25,0.12,'triangle',0.2,0.12); tone(783.99,0.24,'triangle',0.22,0.24); tone(1046.5,0.3,'triangle',0.2,0.4); },
    startBg: function(fast){
      SFX.stopBg();
      var i = 0;
      var interval = fast ? 180 : 260;
      bgTimer = setInterval(function(){
        tone(BG_MELODY[i % BG_MELODY.length], interval/1000*0.9, 'triangle', 0.05, 0);
        if(i % 4 === 0) tone(BG_MELODY[i % BG_MELODY.length]/2, interval/1000*0.9, 'sine', 0.035, 0);
        i++;
      }, interval);
    },
    stopBg: function(){ if(bgTimer){ clearInterval(bgTimer); bgTimer = null; } }
  };
})();

async function startGame(){
