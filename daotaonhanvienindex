        '<div style="display:flex;align-items:center;gap:8px;min-width:0;"><span style="width:22px;text-align:center;font-weight:700;font-size:12.5px;flex-shrink:0;">'+medal+'</span><span style="font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">'+esc(u.name)+'</span></div>'+
        '<div style="display:flex;align-items:center;gap:8px;flex-shrink:0;"><span style="font-size:11px;color:#999;">'+fmtDuration_(u.durationSec)+'</span><span style="font-weight:700;color:#2E7D32;font-size:12.5px;">'+u.correct+'/'+u.total+'</span></div></div>';
    });
    html += '</div>';
  }
  html += '<button type="button" onclick="closeSheet()" class="btn-primary" style="width:100%;padding:12px;border-radius:12px;border:none;margin-top:14px;">Đóng</button>';
