<style>
  :root{
    --gold:#F5A623; --gold-light:#F7C948; --green:#2E7D32; --green-dark:#1B5E20; --cream:#FFFBF0;
  }
  *{box-sizing:border-box;}
  body{font-family:'Be Vietnam Pro',sans-serif; background:var(--cream); margin:0; -webkit-tap-highlight-color:transparent;}
  #appShell{max-width:480px; margin:0 auto; min-height:100vh; background:var(--cream); position:relative; padding-bottom:78px;}
  .grad-brand{background:linear-gradient(135deg,var(--gold) 0%, var(--gold-light) 55%, var(--green) 130%);}
  .grad-progress{background:linear-gradient(90deg,var(--gold) 0%, var(--green) 100%);}
  .card{background:#fff; border-radius:18px; box-shadow:0 2px 12px rgba(0,0,0,0.06);}
  .btn-primary{background:var(--green); color:#fff; font-weight:600;}
  .btn-primary:active{background:var(--green-dark);}
  .btn-gold{background:var(--gold); color:#fff; font-weight:600;}
  .btn-gold:active{background:#e0951c;}
  .tab-btn.active{color:var(--green); font-weight:700;}
  .tab-btn{color:#9CA3AF;}
  .fade-in{animation:fadeIn .25s ease-out;}
  @keyframes fadeIn{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}
  .sheet{animation:sheetUp .28s cubic-bezier(.2,.9,.3,1);}
  @keyframes sheetUp{from{transform:translateY(100%);} to{transform:translateY(0);}}
  .accordion-body{max-height:0; overflow:hidden; transition:max-height .3s ease;}
  ::-webkit-scrollbar{width:6px; height:6px;}
  ::-webkit-scrollbar-thumb{background:#ddd; border-radius:4px;}
  .chip{border-radius:999px; padding:4px 12px; font-size:12px; font-weight:600;}
  #jumpStone{transition:transform .25s ease;}
  @keyframes jumpUp{0%{transform:translateY(0) rotate(0);}45%{transform:translateY(-30px) rotate(-6deg);}100%{transform:translateY(-16px) rotate(0);}}
  @keyframes fallDown{0%{transform:translateY(0);}100%{transform:translateY(90px) rotate(50deg); opacity:0;}}
  .jump-anim{animation:jumpUp .45s ease forwards;}
  .fall-anim{animation:fallDown .6s ease forwards;}
  .pillow-icon{width:36px;height:26px;background:linear-gradient(135deg,#fff,#f2e9da);border-radius:12px;box-shadow:0 3px 6px rgba(0,0,0,.18), inset 0 -3px 4px rgba(0,0,0,.06);position:relative;}
  .pillow-icon::before{content:'';position:absolute;left:6px;top:6px;width:8px;height:8px;border-radius:50%;background:rgba(0,0,0,.05);}
  .pillow-icon::after{content:'';position:absolute;right:6px;top:6px;width:8px;height:8px;border-radius:50%;background:rgba(0,0,0,.05);}
  .stair-step{width:44px;background:linear-gradient(180deg,#F5A623,#e0951c);border-radius:4px 4px 0 0;margin:0 3px;box-shadow:0 1px 2px rgba(0,0,0,.15);}
  .timerbar{height:6px; border-radius:4px; background:linear-gradient(90deg,#4ade80,#facc15,#ef4444); transition:width linear;}
  .btn-disabled{opacity:.45; pointer-events:none;}
  @keyframes bannerBlink{0%,100%{opacity:1;}50%{opacity:.45;}}
  .lesson-banner-blink{animation:bannerBlink 1.1s ease-in-out infinite;}
  .role-chip{display:inline-block;font-size:9.5px;font-weight:700;padding:2px 7px;border-radius:999px;background:#EAF7EC;color:#1B5E20;margin-left:6px;vertical-align:middle;}
  @keyframes spin360{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
  .loading-spin{animation:spin360 1s linear infinite;}
</style>
</head>
