  }
  if(!STATE.quizPool.length){ stopLoadingSheet(); closeSheet(); alert('Chưa có câu hỏi hợp lệ nào để chơi.'); return; }
  stopLoadingSheet();
  GAME_TOKEN++;
  STATE.gameState = { score: 0, stones: 0, alive: true, answering: false, token: GAME_TOKEN };
