}
function nextGameQuestion(){
  if(!STATE.gameState || !STATE.gameState.alive) return;
  var myToken = STATE.gameState.token;
  STATE.gameState.answering = false;
  var pool = STATE.quizPool;
  var q = shuffleWithAnswer_(pool[Math.floor(Math.random()*pool.length)]);
  STATE.gameState.currentQ = q;
  var qBox = document.getElementById('gameQuestionBox');
  if(!qBox) return;
  qBox.textContent = q.question;
  var opts = document.getElementById('gameOptions');
  opts.innerHTML = '';
  q.options.forEach(function(opt, i){
    var b = document.createElement('button');
    b.type = 'button'; b.textContent = opt; b.className = 'game-opt';
    b.style.cssText = 'width:100%;text-align:left;padding:11px 14px;border-radius:12px;border:1px solid #ddd;margin-bottom:7px;background:#fff;font-size:13px;';
    b.onclick = function(){ answerGame(i); };
    opts.appendChild(b);
  });
  document.getElementById('gameEndBox').innerHTML = '';
  var bar = document.getElementById('gameTimerBar');
  var txt = document.getElementById('gameTimerText');
  bar.style.transition = 'none'; bar.style.width='100%';
  void bar.offsetWidth;
  bar.style.transition = 'width '+GAME_TIME_LIMIT+'s linear'; bar.style.width='0%';
  var remaining = GAME_TIME_LIMIT;
  if(txt) txt.textContent = remaining + 's';
  clearTimeout(GAME_TIMER); clearInterval(GAME_COUNTDOWN); GAME_TIMER = null;
  GAME_COUNTDOWN = setInterval(function(){
    if(!STATE.gameState || STATE.gameState.token !== myToken){ clearInterval(GAME_COUNTDOWN); return; }
    remaining--;
    var txt2 = document.getElementById('gameTimerText');
    if(txt2) txt2.textContent = Math.max(remaining,0) + 's';
    if(remaining === 5) SFX.startBg(true);
    if(remaining > 0 && remaining <= 5) SFX.tick();
    if(remaining <= 0){ clearInterval(GAME_COUNTDOWN); answerGame(-1); }
  }, 1000);
}
function answerGame(i){
  if(!STATE.gameState || !STATE.gameState.alive || STATE.gameState.answering) return;
  var myToken = STATE.gameState.token;
  STATE.gameState.answering = true;
  clearTimeout(GAME_TIMER); clearInterval(GAME_COUNTDOWN);
  var q = STATE.gameState.currentQ;
  var correct = i === q.answerIndex;
  var opts = document.querySelectorAll('#gameOptions .game-opt');
  opts.forEach(function(o){ o.style.pointerEvents='none'; o.disabled = true; });
  if(i>=0 && opts[i]){ opts[i].style.background = correct ? '#EAF7EC':'#FCEBEA'; opts[i].style.borderColor = correct?'#2E7D32':'#c0392b'; }
  if(!correct && opts[q.answerIndex]){ opts[q.answerIndex].style.background = '#EAF7EC'; opts[q.answerIndex].style.borderColor = '#2E7D32'; }
  var stone = document.getElementById('jumpStone');
  var endBox = document.getElementById('gameEndBox');
  if(correct){
    SFX.correct();
    STATE.gameState.score += 10; STATE.gameState.stones++;
    document.getElementById('gameScore').textContent = STATE.gameState.score;
    var stack = document.getElementById('stairsStack');
    var stepCount = Math.min(STATE.gameState.stones, 8);
    var step = document.createElement('div'); step.className = 'stair-step';
    step.style.height = (14 * stepCount) + 'px'; stack.appendChild(step);
    stone.style.bottom = (14 * stepCount + 4) + 'px';
    stone.classList.remove('jump-anim'); void stone.offsetWidth; stone.classList.add('jump-anim');
    if(endBox) endBox.innerHTML = '<div style="color:#2E7D32;font-size:12.5px;font-weight:700;margin-top:6px;">Chính xác! +10 điểm...</div>';
    if(STATE.gameState.score >= GAME_PASS_SCORE && !STATE.gameState.wonSfxPlayed){ STATE.gameState.wonSfxPlayed = true; SFX.win(); }
    setTimeout(function(){ if(STATE.gameState && STATE.gameState.alive && STATE.gameState.token===myToken){ SFX.startBg(false); nextGameQuestion(); } }, 900);
  } else {
    SFX.wrong(); SFX.stopBg();
    stone.classList.remove('fall-anim'); void stone.offsetWidth; stone.classList.add('fall-anim');
    STATE.gameState.alive = false;
    var finalScore = STATE.gameState.score;
    if(endBox){
      endBox.innerHTML = '<div style="color:#c0392b;font-size:13px;font-weight:700;margin-top:8px;">Gối đã rơi! '+(i<0?'Hết giờ trả lời.':'Trả lời sai.')+' Điểm phiên còn lại: '+finalScore+'</div>'+
        (finalScore >= GAME_PASS_SCORE ? '<div style="color:#2E7D32;font-size:12.5px;margin-top:4px;">Đã đạt mốc '+GAME_PASS_SCORE+' điểm — vẫn có thể lưu điểm!</div>' : '');
    }
    document.getElementById('gameOptions').innerHTML = '<button type="button" onclick="startGame()" class="btn-gold" style="width:100%;padding:11px;border-radius:12px;border:none;margin-top:8px;">Chơi lại</button>';
  }
}
async function endGame(save){
  clearTimeout(GAME_TIMER); clearInterval(GAME_COUNTDOWN); GAME_TOKEN++;
  SFX.stopBg();
  var score = STATE.gameState ? STATE.gameState.score : 0;
  STATE.gameState = null; closeSheet();
  if(save && score > 0 && STATE.session){
    showLoadingSheet('Đang lưu điểm của bạn...', 2000);
    try{
      var res = await serverCall('submitGameScore', STATE.session.phone, score);
      STATE.session.points = res.points;
      if(res.streak !== undefined) STATE.session.streak = res.streak;
      if(res.bestStreak !== undefined) STATE.session.bestStreak = res.bestStreak;
      if(score >= GAME_PASS_SCORE) STATE.session.gamePassed = true;
      saveSession(); renderHeader();
      STATE.leaderboard = await serverCall('getLeaderboard');
      stopLoadingSheet(); closeSheet();
      if(STATE.currentTab==='rank') renderTab();
      if(score >= GAME_PASS_SCORE) setTimeout(function(){ alert('Chúc mừng! Hoàn tất Thử thách Tốt nghiệp với ' + score + ' điểm.'); }, 200);
    }catch(e){ stopLoadingSheet(); closeSheet(); alert('Lỗi lưu điểm: '+e.message); }
  }
}

