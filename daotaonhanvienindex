<script>
// Âm thanh "click" nhẹ mỗi khi bấm nút trong toàn app — GIỮ NGUYÊN hiệu ứng âm thanh,
// chỉ bỏ nhạc nền tự động ở trang chính (nhạc nền chỉ còn ở trang link bài kiểm tra riêng).
document.addEventListener('click', function(ev){
  if(ev.target.closest && ev.target.closest('button') && typeof SFX!=='undefined' && SFX.click) SFX.click();
}, true);

setTimeout(function(){
  var boot = document.getElementById('bootScreen');
  if(boot && boot.style.display !== 'none'){
    var box = document.getElementById('bootErrorBox');
    var msg = document.getElementById('bootErrorMsg');
    if(box) box.style.display = 'block';
    if(msg) msg.textContent = 'Ứng dụng tải quá 15 giây. Có thể do: (1) Chưa Deploy phiên bản mới, (2) Lỗi cú pháp JavaScript trong Index.html, (3) Chưa cấp quyền Authorize lần đầu. Hãy mở F12 (hoặc chrome://inspect trên máy tính) để xem lỗi console cụ thể.';
  }
}, 15000);

/* ===================== 1. BOOT / DIAGNOSTIC LAYER ===================== */
var bootLogEl, bootMsgEl, bootBarEl;
function bootLog(msg){
  console.log('[BOOT]', msg);
  if(!bootLogEl) bootLogEl = document.getElementById('bootLogBox');
  var row = document.createElement('div');
  row.textContent = '• ' + msg;
  bootLogEl.appendChild(row);
  bootLogEl.scrollTop = bootLogEl.scrollHeight;
}
function setBootMsg(msg, pct){
  if(!bootMsgEl) bootMsgEl = document.getElementById('bootMsg');
  if(!bootBarEl) bootBarEl = document.getElementById('bootBar');
  bootMsgEl.textContent = msg;
  if(pct !== undefined){
    bootBarEl.style.width = pct + '%';
    var pctEl = document.getElementById('bootPct');
    if(pctEl) pctEl.textContent = pct + '%';
  }
}
function showBootError(msg){
  document.getElementById('bootErrorBox').style.display = 'block';
  document.getElementById('bootErrorMsg').textContent = msg;
  setBootMsg('Không thể tải ứng dụng');
}
window.onerror = function(msg, url, line, col, err){
  bootLog('Lỗi JS: ' + msg + ' (dòng ' + line + ')');
  if(document.getElementById('appShell').style.display === 'none'){
    showBootError(String(msg) + '\n(dòng ' + line + ', cột ' + col + ')');
  }
  return false;
};
window.addEventListener('unhandledrejection', function(ev){
  bootLog('Promise lỗi: ' + (ev.reason && ev.reason.message ? ev.reason.message : ev.reason));
  if(document.getElementById('appShell').style.display === 'none'){
    showBootError(String(ev.reason && ev.reason.message ? ev.reason.message : ev.reason));
  }
});

function withTimeout(promise, ms, label){
  return new Promise(function(resolve, reject){
    var done = false;
    var timer = setTimeout(function(){
      if(!done){ done = true; reject(new Error('Hết thời gian chờ (' + label + ') sau ' + (ms/1000) + 's. Kiểm tra kết nối mạng hoặc thử Deploy lại.')); }
    }, ms);
    promise.then(function(res){
      if(!done){ done = true; clearTimeout(timer); resolve(res); }
    }).catch(function(err){
      if(!done){ done = true; clearTimeout(timer); reject(err); }
    });
  });
}

function serverCall(fnName){
  var args = Array.prototype.slice.call(arguments, 1);
  return new Promise(function(resolve, reject){
    if(typeof google === 'undefined' || !google.script || !google.script.run){
      reject(new Error('Kênh google.script.run không khả dụng. Hãy chắc chắn trang được mở qua link /exec.'));
      return;
    }
    google.script.run
      .withSuccessHandler(resolve)
      .withFailureHandler(function(err){ reject(new Error(err && err.message ? err.message : String(err))); })[fnName].apply(null, args);
  });
}

/* ===================== 2. STATE ===================== */
var STATE = {
  appData: null,
  session: null,
  adminOn: false,
  adminPassword: '',
  currentTab: 'home',
  moreFilter: null,
  leaderboard: [],
  myProgress: {progress:{}, points:0},
  quizPool: [],
  gameState: null
};

/* ===================== 3. BOOT SEQUENCE ===================== */

async function boot(){
  try{
    setBootMsg('Đang đọc phiên đăng nhập...', 15);
    bootLog('Đọc localStorage');
    try{
      var saved = localStorage.getItem('nv_session_9sach');
      if(saved) STATE.session = JSON.parse(saved);
    }catch(e){ bootLog('Không đọc được session cũ'); }

    setBootMsg('Kiểm tra kết nối máy chủ...', 30);
    bootLog('Kiểm tra google.script.run');
    if(typeof google === 'undefined' || !google.script || !google.script.run){
      throw new Error('google.script.run không tồn tại. Trang có thể chưa được mở đúng qua link /exec.');
    }

    setBootMsg('Đang ping máy chủ...', 45);
    bootLog('Gọi ping()');
    await withTimeout(serverCall('ping'), 15000, 'ping');
    bootLog('Ping OK');

    setBootMsg('Đang tải dữ liệu ứng dụng...', 65);
    bootLog('Gọi getAppData()');
    STATE.appData = normalizeAppData_(await withTimeout(serverCall('getAppData'), 20000, 'getAppData'));
    bootLog('Đã có dữ liệu ứng dụng');
    try{ STATE.webAppUrl = await serverCall('getWebAppUrl'); }
catch(e){ STATE.webAppUrl = window.location.href.split('?')[0]; }

    setBootMsg('Hoàn tất, đang hiển thị...', 90);
    document.getElementById('bootScreen').style.display = 'none';
    document.getElementById('appShell').style.display = 'block';

    renderHeader();
    switchTab('home');

    loadSecondaryData();
  }catch(err){
    bootLog('LỖI: ' + err.message);
    showBootError(err.message);
  }
}

function normalizeAppData_(d){
  d = d || {};
  d.companyIntro = d.companyIntro || { title: 'Giới thiệu công ty', content: '', imageUrl:'', videoUrl:'', orgChart: [] };
  d.companyIntro.orgChart = d.companyIntro.orgChart || [];
  d.productStandards = d.productStandards || { title: 'Tiêu chuẩn chất lượng & An toàn thực phẩm', certification:'', safetyLimits:'', storageBands: [], generalRules: [], packagingNote:'', imageUrl:'', videoUrl:'', refLink:'' };
  d.productStandards.storageBands = d.productStandards.storageBands || [];
  d.productStandards.generalRules = d.productStandards.generalRules || [];
  d.kpi = d.kpi || { formula:'Chưa cấu hình', example:'', seniorityTable: [], seniorityNote:'', breakevenTable: [], breakevenNote:'', behaviorTable: [], behaviorNote:'', criteriaGroups: [], managerScoreNote:'', notes: [] };
  d.kpi.seniorityTable = d.kpi.seniorityTable || [];
  d.kpi.breakevenTable = d.kpi.breakevenTable || [];
  d.kpi.behaviorTable = d.kpi.behaviorTable || [];
  d.kpi.criteriaGroups = d.kpi.criteriaGroups || [];
  d.kpi.notes = d.kpi.notes || [];
  d.storeEval = d.storeEval || { note: '', groups: [] };
  d.storeEval.groups = d.storeEval.groups || [];
  d.coreValues = d.coreValues || [];
  d.productLines = d.productLines || [];
  d.products = d.products || [];
  d.stores = d.stores || [];
  d.sop = d.sop || [];
  d.operationGuides = d.operationGuides || [];
  d.salesScripts = d.salesScripts || [];
  d.sellingSkills = d.sellingSkills || [];
  d.tacPhongImages = d.tacPhongImages || [];
  d.qlchContent = d.qlchContent || [];
  d.b2bTopics = d.b2bTopics || [];
   d.qlchInfo = d.qlchInfo || { income:'', workRules:'', reporting:'', salesOps:'', internalComm:'' };
  d.wholesaleCustomers = d.wholesaleCustomers || [];
  d.weeks = d.weeks || [];
  d.weeks.forEach(function(w){ if(!w.audience) w.audience = 'all'; });
  return d;
}
function loadSecondaryData(){
  serverCall('getLeaderboard').then(function(r){ STATE.leaderboard = r; if(STATE.currentTab==='rank') renderTab(); }).catch(function(e){ bootLog('Lỗi tải xếp hạng: '+e.message); });
  checkLessonBanner();
  if(STATE.session && STATE.session.phone){
    serverCall('getMyProgress', STATE.session.phone).then(function(r){
      STATE.myProgress = r;
      STATE.session.points = r.points;
      if(r.streak !== undefined) STATE.session.streak = r.streak;
      if(r.bestStreak !== undefined) STATE.session.bestStreak = r.bestStreak;
      saveSession();
      renderHeader();
      if(STATE.currentTab==='training') renderTab();
    }).catch(function(e){ bootLog('Lỗi tải tiến độ: '+e.message); });
  }
}

function saveSession(){
  try{ localStorage.setItem('nv_session_9sach', JSON.stringify(STATE.session)); }catch(e){}
}
function clearSession(){
  STATE.session = null;
  try{ localStorage.removeItem('nv_session_9sach'); }catch(e){}
}

/* ===================== BANNER BÀI HỌC MỚI ===================== */
function getCompletedLessonIds_(){
  try{ return JSON.parse(localStorage.getItem('completed_lessons_9sach') || '[]'); }catch(e){ return []; }
}
function markLessonCompleted_(id){
  var list = getCompletedLessonIds_();
  if(list.indexOf(id) === -1){ list.push(id); try{ localStorage.setItem('completed_lessons_9sach', JSON.stringify(list)); }catch(e){} }
}
function checkLessonBanner(){
  serverCall('listActiveLessonBanner').then(function(info){
    var el = document.getElementById('lessonBanner');
    if(!el) return;
    if(!info){ el.style.display='none'; return; }
    var done = getCompletedLessonIds_().indexOf(info.id) !== -1;
    if(done){ el.style.display='none'; return; }
    document.getElementById('lessonBannerText').textContent = 'Bài học mới: ' + info.title;
    el.dataset.lessonId = info.id;
    el.style.display = 'block';
  }).catch(function(){});
}
function openLessonBanner(){
  var el = document.getElementById('lessonBanner');
  var id = el ? el.dataset.lessonId : null;
  if(!id) return;
  // cũ: var base = window.location.href.split('?')[0];
var base = STATE.webAppUrl || window.location.href.split('?')[0];
  window.open(base + '?lesson=' + encodeURIComponent(id), '_blank');
}

/* ===================== 4. HEADER / NAV ===================== */
function renderHeader(){
  document.getElementById('adminBadge').style.display = STATE.adminOn ? 'inline-block' : 'none';
  var pw = document.getElementById('pointsWrap');
  var sw = document.getElementById('streakWrap');
  if(STATE.session && STATE.session.phone){
    pw.style.display = 'inline-flex';
    document.getElementById('headerPoints').textContent = STATE.session.points || 0;
    if(STATE.session.streak > 0){
      sw.style.display = 'inline-flex';
      document.getElementById('headerStreak').textContent = STATE.session.streak;
    } else {
      sw.style.display = 'none';
    }
  } else {
    pw.style.display = 'none';
    sw.style.display = 'none';
  }
}

function switchTab(tab){
  STATE.currentTab = tab;
  document.querySelectorAll('.tab-btn').forEach(function(b){
    b.classList.toggle('active', b.dataset.tab === tab);
  });
  renderTab();
}

function renderTab(){
  var main = document.getElementById('mainContent');
  main.innerHTML = '';
  main.classList.remove('fade-in'); void main.offsetWidth; main.classList.add('fade-in');
  if(STATE.currentTab === 'home') renderHome(main);
  else if(STATE.currentTab === 'training') renderTraining(main);
  else if(STATE.currentTab === 'rank') renderRank(main);
  else if(STATE.currentTab === 'more') renderMore(main);
}

function esc(s){ return (s===undefined||s===null) ? '' : String(s).replace(/[&<>"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
function nl2br(s){ return esc(s).replace(/\n/g,'<br>'); }
function smartFormat(s){
  if(!s) return '';
  var t = String(s);
  // Tự tách các ý dạng "...; (2) ..." hoặc "...(2) ..." thành từng dòng riêng
  t = t.replace(/\s*;\s*(?=\(\d+\))/g, '\n');
  t = t.replace(/([^\n])\s+(?=\(\d+\)\s)/g, '$1\n');
  return nl2br(t);
}
function money(n){ return (n===null||n===undefined||n==='') ? '—' : Number(n).toLocaleString('vi-VN') + 'đ'; }
function mediaBlock(item){
  var html = '';
  if(item.imageUrl) html += '<img src="'+esc(item.imageUrl)+'" style="width:100%;border-radius:10px;margin:8px 0;" onerror="this.style.display=\'none\'">';
  if(item.videoUrl) html += renderVideoEmbed(item.videoUrl);
  if(item.refLink) html += '<a href="'+esc(item.refLink)+'" target="_blank" style="font-size:12px;color:#2E7D32;display:inline-block;margin-top:4px;">Xem thêm <i class="fa-solid fa-arrow-up-right-from-square"></i></a>';
  return html;
}
function sortEmptyLast(list, isEmptyFn){
  return list.slice().sort(function(a,b){
    var ae = isEmptyFn(a), be = isEmptyFn(b);
    if(ae===be) return 0;
    return ae ? 1 : -1;
  });
}
function streakBadge(n){
  if(n>=30) return '👑 '+n+' ngày — Huyền thoại';
  if(n>=14) return '🏅 '+n+' ngày — Xuất sắc';
  if(n>=7) return '🔥🔥 '+n+' ngày — Rất chăm';
  if(n>=3) return '🔥 '+n+' ngày — Đang lên đà';
  if(n>=1) return '🌱 '+n+' ngày';
  return '';
}

/* ===================== 4B. LOADING SHEET DÙNG CHUNG (chống đơ/đứng UI) ===================== */
var LOADING_BAR_TIMER = null;
function loadingSheetHtml(msg){
  return '<div style="text-align:center;padding:34px 10px 20px;">'+
    '<div style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#F5A623,#2E7D32);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">'+
    '<i class="fa-solid fa-circle-notch loading-spin" style="color:#fff;font-size:22px;"></i></div>'+
    '<div style="font-weight:700;font-size:14px;color:#1B5E20;margin-bottom:16px;">'+esc(msg)+'</div>'+
    '<div style="width:220px;height:8px;background:#eee;border-radius:6px;overflow:hidden;margin:0 auto;">'+
    '<div id="genericLoadingBar" style="height:100%;width:6%;background:linear-gradient(90deg,#F5A623,#2E7D32);transition:width .25s;"></div></div>'+
    '<div id="genericLoadingPct" style="margin-top:8px;font-size:12px;color:#999;">6%</div>'+
  '</div>';
}
function showLoadingSheet(msg, estimatedMs){
  clearInterval(LOADING_BAR_TIMER);
  openSheet(loadingSheetHtml(msg));
  var start = Date.now();
  var maxMs = estimatedMs || 4000;
  LOADING_BAR_TIMER = setInterval(function(){
    var bar = document.getElementById('genericLoadingBar');
    var pctEl = document.getElementById('genericLoadingPct');
    if(!bar){ clearInterval(LOADING_BAR_TIMER); return; }
    var elapsed = Date.now() - start;
    var pctVal = Math.min(94, Math.round((elapsed/maxMs)*100));
    bar.style.width = pctVal + '%';
    if(pctEl) pctEl.textContent = pctVal + '%';
  }, 120);
}
function stopLoadingSheet(){
  clearInterval(LOADING_BAR_TIMER);
  var bar = document.getElementById('genericLoadingBar');
  var pctEl = document.getElementById('genericLoadingPct');
  if(bar) bar.style.width = '100%';
  if(pctEl) pctEl.textContent = '100%';
}

