  });
  html += '</div><div id="quizFeedback"></div>';
  openSheet(html);
}
function answerQuiz(i){
  if(!QUIZ_STATE || QUIZ_STATE.locked) return;
  QUIZ_STATE.locked = true;
  var q = QUIZ_STATE.quiz[QUIZ_STATE.idx];
  var opts = document.querySelectorAll('#quizOptions .quiz-opt');
  if(!opts || !opts.length) return;
  opts.forEach(function(o){ o.style.pointerEvents='none'; o.disabled = true; });
  var answerIdx = (typeof q.answerIndex === 'number' && q.answerIndex >= 0 && q.answerIndex < opts.length) ? q.answerIndex : 0;
  var isCorrect = i === answerIdx;
  if(isCorrect) SFX.correct(); else SFX.wrong();
  if(opts[i]){
    opts[i].style.borderColor = isCorrect ? '#2E7D32' : '#c0392b';
    opts[i].style.background = isCorrect ? '#EAF7EC' : '#FCEBEA';
  }
  if(!isCorrect && opts[answerIdx]){ opts[answerIdx].style.borderColor = '#2E7D32'; opts[answerIdx].style.background = '#EAF7EC'; }
  if(isCorrect) QUIZ_STATE.correct++;
  QUIZ_STATE.answers.push(isCorrect);
  var fb = document.getElementById('quizFeedback');
  if(!fb) return;
  var isLast = QUIZ_STATE.idx >= QUIZ_STATE.quiz.length - 1;
  var noteText = (q.explain && q.explain.trim()) ? q.explain.trim() : 'Hãy xem lại nội dung liên quan ở mục Quy định/Kiến thức sản phẩm để ghi nhớ kỹ hơn câu này.';
  fb.innerHTML =
    '<div style="margin-top:10px;font-size:12.5px;font-weight:700;'+(isCorrect?'color:#2E7D32;':'color:#c0392b;')+'">'+(isCorrect?'✅ Chính xác!':'❌ Chưa đúng.')+'</div>'+
    '<div style="margin-top:6px;background:#FFF7E6;border-left:4px solid #F5A623;border-radius:8px;padding:10px 12px;">'+
      '<div style="font-size:11.5px;font-weight:800;color:#8a5a00;text-transform:uppercase;letter-spacing:.3px;margin-bottom:3px;"><i class="fa-solid fa-lightbulb"></i> Lưu ý để ghi nhớ</div>'+
      '<div style="font-size:12.5px;color:#5c4400;line-height:1.55;">'+esc(noteText)+'</div>'+
    '</div>'+
    '<button type="button" onclick="nextQuizStep()" class="btn-primary" style="width:100%;padding:12px;border-radius:12px;border:none;margin-top:12px;">'+
    (isLast ? 'Xem kết quả' : 'Câu tiếp theo') + '</button>';
}

/* nextQuizStep: nộp bài kèm thời gian làm bài, tải bảng xếp hạng riêng của "Ngày" đó
   (đúng nhiều nhất lên trước, bằng điểm thì nhanh hơn lên trước) và hiển thị ngay. */
async function nextQuizStep(){
  if(!QUIZ_STATE) return;
