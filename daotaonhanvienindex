function toggleAcc(id){
  var el = document.getElementById(id);
  var arrow = document.getElementById(id+'_arrow');
  if(el.style.maxHeight && el.style.maxHeight !== '0px'){
    el.style.maxHeight = '0px'; arrow.style.transform='rotate(0deg)';
  } else {
    el.style.maxHeight = el.scrollHeight + 'px'; arrow.style.transform='rotate(180deg)';
  }
}

/* ===================== 6. TAB: ĐÀO TẠO (lộ trình hội nhập + tuần) ===================== */
function renderTraining(main){
  if(!STATE.session){
    main.innerHTML = authForm();
    return;
  }
  var d = STATE.appData;
  var myRole = STATE.session.role || 'NhanVien';
  var visibleWeeks = STATE.adminOn ? d.weeks : d.weeks.filter(function(w){ return !w.audience || w.audience==='all' || w.audience===myRole; });
  var prog = STATE.myProgress.progress || {};
  var totalLessons = 0, doneLessons = 0;
  visibleWeeks.forEach(function(w){ w.lessons.forEach(function(l){ totalLessons++; if(prog[l.id] && prog[l.id].passed) doneLessons++; }); });
  var pct = totalLessons ? Math.round(doneLessons/totalLessons*100) : 0;
  var gameDone = !!(STATE.session.gamePassed);

  var html = '<div class="card" style="padding:16px;margin-bottom:14px;">';
  html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">';
  html += '<div style="font-weight:700;font-size:14px;">Xin chào, '+esc(STATE.session.name)+'</div>';
  html += '<button onclick="logout()" style="font-size:11px;color:#c0392b;background:none;border:none;">Đăng xuất</button></div>';
  html += '<div style="font-size:12px;color:#666;margin-bottom:6px;">Tiến độ: '+doneLessons+'/'+totalLessons+' bài — Điểm tích lũy: <b>'+(STATE.session.points||0)+'</b></div>';
  if(STATE.session.streak > 0){
    html += '<div style="font-size:12px;color:#e0951c;font-weight:700;margin-bottom:6px;">'+streakBadge(STATE.session.streak)+(STATE.session.bestStreak?(' <span style="color:#999;font-weight:400;">(Kỷ lục cá nhân: '+STATE.session.bestStreak+' ngày)</span>'):'')+'</div>';
  }
  html += '<div style="height:8px;background:#eee;border-radius:6px;overflow:hidden;"><div class="grad-progress" style="height:100%;width:'+pct+'%;"></div></div>';
  html += '</div>';

  // v6.2: Đào tạo QLCH / B2B — chỉ hiện với Admin hoặc nhân viên được phân quyền đúng vai trò
  if(STATE.adminOn || myRole === 'QLCH'){
    html += roleTrainingCard('fa-user-tie', 'Đào tạo Quản lý cửa hàng (QLCH)', 'Nghiệp vụ quản lý, kết ca, chấm công, KiotViet dành riêng cho QLCH.', "goToMoreFilter('qlch')");
  }
  if(STATE.adminOn || myRole === 'B2B'){
    html += roleTrainingCard('fa-handshake', 'Đào tạo Nhân viên B2B', '20 chủ đề vận hành khách sỉ, đại lý, kênh Modern Trade.', "goToMoreFilter('b2b')");
  }

var unlockedWeek = true;
visibleWeeks.forEach(function(week, wi){
    var weekDone = week.lessons.every(function(l){ return prog[l.id] && prog[l.id].passed; });
    var roleTag = (week.audience && week.audience!=='all') ? '<span class="role-chip">'+esc(week.audience)+'</span>' : '';

    if(week.lessons.length === 1){
      // Đơn vị "Ngày N" — cả thẻ là 1 nút bấm, không lặp lại tiêu đề
      var lesson = week.lessons[0];
      var passed = prog[lesson.id] && prog[lesson.id].passed;
      var canOpen = STATE.adminOn || unlockedWeek;
      html += '<button '+(canOpen?('onclick="openLesson(\''+week.id+'\',\''+lesson.id+'\')"'):'')+' class="card fade-in '+(canOpen?'':'btn-disabled')+'" style="width:100%;text-align:left;border:none;display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;padding:14px 16px;'+(canOpen?'':'opacity:.55;')+'">';
      html += '<div style="display:flex;align-items:center;gap:10px;flex:1;min-width:0;">';
      html += '<i class="fa-solid '+(passed?'fa-circle-check':(canOpen?'fa-circle-play':'fa-lock'))+'" style="font-size:17px;color:'+(passed?'#2E7D32':(canOpen?'#F5A623':'#bbb'))+';flex-shrink:0;"></i>';
      html += '<div style="min-width:0;"><div style="font-weight:800;font-size:13.5px;color:#1B5E20;">'+esc(week.title)+roleTag+'</div><div style="font-size:11.5px;color:#888;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">'+esc(lesson.title.replace(/^Ngày\s*\d+:\s*/i,''))+'</div></div>';
      html += '</div><i class="fa-solid fa-chevron-right" style="font-size:12px;color:#bbb;flex-shrink:0;"></i></button>';
    } else {
      html += '<div class="card fade-in" style="margin-bottom:12px;padding:14px 16px;'+(unlockedWeek?'':'opacity:.55;')+'">';
      html += '<div style="font-weight:800;font-size:14px;color:#1B5E20;margin-bottom:8px;">'+(unlockedWeek?'':'<i class="fa-solid fa-lock"></i> ')+esc(week.title)+roleTag+'</div>';
      var lessonUnlocked = unlockedWeek;
      week.lessons.forEach(function(lesson){
        var passed2 = prog[lesson.id] && prog[lesson.id].passed;
        var canOpen2 = STATE.adminOn || lessonUnlocked;
        html += '<button '+(canOpen2?('onclick="openLesson(\''+week.id+'\',\''+lesson.id+'\')"'):'')+' class="'+(canOpen2?'':'btn-disabled')+'" style="width:100%;display:flex;align-items:center;justify-content:space-between;padding:10px 0;background:none;border:none;border-top:1px solid #f2f2f2;text-align:left;">';
        html += '<span style="font-size:13px;color:#333;"><i class="fa-solid '+(passed2?'fa-circle-check':(canOpen2?'fa-circle-play':'fa-lock'))+'" style="color:'+(passed2?'#2E7D32':(canOpen2?'#F5A623':'#bbb'))+';margin-right:8px;"></i>'+esc(lesson.title)+'</span>';
        html += '<i class="fa-solid fa-chevron-right" style="font-size:11px;color:#bbb;"></i></button>';
        if(!passed2) lessonUnlocked = false;
      });
      html += '</div>';
    }
    if(!weekDone) unlockedWeek = false;
});

  var allLessonsDone = totalLessons > 0 && doneLessons === totalLessons;
  html += '<div class="card fade-in" style="margin-bottom:12px;padding:14px 16px;'+(allLessonsDone?'':'opacity:.55;')+'">';
  html += '<div style="display:flex;justify-content:space-between;align-items:center;">';
  html += '<div style="font-weight:800;font-size:14px;color:#1B5E20;">'+(allLessonsDone?'':'<i class="fa-solid fa-lock"></i> ')+'🛏️ Thử thách Tốt nghiệp — Gối Nhảy Bậc Thang</div>';
  html += (gameDone?'<i class="fa-solid fa-circle-check" style="color:#2E7D32;"></i>':'');
  html += '</div>';
  html += '<div style="font-size:12px;color:#666;margin-top:6px;">Bài tập bắt buộc cuối khóa: đạt tối thiểu '+GAME_PASS_SCORE+' điểm trong trò chơi để chính thức hoàn tất lộ trình đào tạo.</div>';
  if(allLessonsDone){
    html += '<button onclick="switchTab(\'rank\')" class="btn-gold" style="width:100%;padding:11px;border-radius:12px;border:none;margin-top:10px;font-size:13px;">'+(gameDone?'Chơi lại để nâng điểm':'Đi tới trò chơi')+'</button>';
  }
  html += '</div>';

  if(STATE.adminOn){
    html += '<button onclick="openWeekForm()" class="btn-gold" style="width:100%;padding:12px;border-radius:14px;border:none;margin-top:6px;"><i class="fa-solid fa-plus"></i> Thêm ngày đào tạo</button>';
  }
  main.innerHTML = html;
}
