/* ===================== 9B. UPLOAD ẢNH TRỰC TIẾP (thay cho dán link) ===================== */
function fileToBase64_(file){
  return new Promise(function(resolve, reject){
    var reader = new FileReader();
    reader.onload = function(){ resolve(String(reader.result).split(',')[1]); };
    reader.onerror = function(){ reject(new Error('Không đọc được tệp ảnh.')); };
    reader.readAsDataURL(file);
  });
}
function imageUploadFieldHtml(id, label, currentUrl){
  var preview = currentUrl ?
    ('<img id="'+id+'_preview" src="'+esc(currentUrl)+'" style="width:100%;max-height:130px;object-fit:cover;border-radius:10px;margin-bottom:6px;" onerror="this.style.display=\'none\'">') :
    ('<div id="'+id+'_preview" style="display:none;"></div>');
  return '<div style="margin-bottom:10px;">'+
    '<label style="font-size:11.5px;color:#666;display:block;margin-bottom:4px;">'+esc(label)+'</label>'+
    preview +
    '<input type="file" accept="image/*" id="'+id+'" onchange="previewImageInput_(\''+id+'\')" style="width:100%;padding:8px;border-radius:8px;border:1px solid #ddd;font-size:12px;background:#fff;">'+
    '<input type="hidden" id="'+id+'_existing" value="'+esc(currentUrl||'')+'">'+
    (currentUrl ? '<div style="font-size:10.5px;color:#999;margin-top:3px;">Chọn ảnh mới để thay thế, hoặc để trống để giữ ảnh hiện tại.</div>' : '') +
  '</div>';
}
function previewImageInput_(id){
  var inp = document.getElementById(id);
  var prev = document.getElementById(id+'_preview');
  if(!inp || !inp.files || !inp.files[0] || !prev) return;
  var url = URL.createObjectURL(inp.files[0]);
  prev.src = url; prev.style.display = 'block'; prev.tagName === 'IMG' ? null : null;
  if(prev.tagName !== 'IMG'){
    var img = document.createElement('img');
    img.id = id+'_preview'; img.src = url;
    img.style.cssText = 'width:100%;max-height:130px;object-fit:cover;border-radius:10px;margin-bottom:6px;';
    prev.replaceWith(img);
  }
}
async function uploadImageIfSelected(id){
  var inp = document.getElementById(id);
  var existingEl = document.getElementById(id+'_existing');
  var existing = existingEl ? existingEl.value : '';
  if(inp && inp.files && inp.files[0]){
    var file = inp.files[0];
    if(file.size > 4.5 * 1024 * 1024){ throw new Error('Ảnh "'+file.name+'" quá lớn (tối đa ~4.5MB). Vui lòng chọn ảnh nhỏ hơn.'); }
    var b64 = await fileToBase64_(file);
    var res = await serverCall('uploadImage', STATE.adminPassword, b64, file.name, file.type);
    return res.url;
  }
  return existing || '';
}
async function withSavingState(btn, fn){
  var original = btn ? btn.innerHTML : null;
  if(btn){ btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang lưu...'; }
  try{
    await fn();
  }catch(e){
    alert('Lỗi lưu: ' + e.message);
  }finally{
    if(btn){ btn.disabled = false; btn.innerHTML = original; }
  }
}

