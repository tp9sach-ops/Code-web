function findLesson(weekId, lessonId){
  var week = STATE.appData.weeks.find(function(w){ return w.id === weekId; });
  var lesson = week.lessons.find(function(l){ return l.id === lessonId; });
  return {week: week, lesson: lesson};
}

function openLesson(weekId, lessonId){
  var f = findLesson(weekId, lessonId);
  var lesson = f.lesson;
  var html = '<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;">';
  html += '<div style="font-weight:800;font-size:16px;color:#1B5E20;padding-right:10px;">'+esc(lesson.title)+'</div>';
  html += '<button onclick="closeSheet()" style="background:#f2f2f2;border:none;width:30px;height:30px;border-radius:50%;flex-shrink:0;"><i class="fa-solid fa-xmark"></i></button></div>';
  if(lesson.audience) html += '<span class="chip" style="background:#FFF3D6;color:#8a5a00;margin-bottom:10px;display:inline-block;">Đối tượng: '+esc(lesson.audience)+'</span>';
  html += '<div style="font-size:13.5px;color:#444;line-height:1.7;white-space:pre-wrap;margin:10px 0;">'+nl2br(lesson.content)+'</div>';
  if(lesson.script){
    html += '<div style="background:#F5FBF6;border-radius:12px;padding:12px;margin-bottom:10px;"><div style="font-weight:700;font-size:12px;color:#1B5E20;margin-bottom:4px;"><i class="fa-solid fa-comment-dots"></i> Kịch bản chuẩn</div><div style="font-size:13px;color:#333;white-space:pre-wrap;">'+nl2br(lesson.script)+'</div></div>';
  }
  if(lesson.videoUrl){
    html += renderVideoEmbed(lesson.videoUrl);
  }
  if(lesson.refLink){
    html += '<a href="'+esc(lesson.refLink)+'" target="_blank" style="font-size:12px;color:#2E7D32;">Xem tài liệu tham khảo <i class="fa-solid fa-arrow-up-right-from-square"></i></a>';
  }
  if(lesson.images && lesson.images.length){
    var dung = lesson.images.filter(function(i){ return i.type==='dung'; });
    var sai = lesson.images.filter(function(i){ return i.type==='sai'; });
    html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0;">';
    html += '<div><div style="font-weight:700;font-size:12px;color:#2E7D32;margin-bottom:6px;"><i class="fa-solid fa-check"></i> Nên làm</div>' + dung.map(function(i){ return imgBlock(i); }).join('') + '</div>';
    html += '<div><div style="font-weight:700;font-size:12px;color:#c0392b;margin-bottom:6px;"><i class="fa-solid fa-xmark"></i> Không nên</div>' + sai.map(function(i){ return imgBlock(i); }).join('') + '</div>';
    html += '</div>';
  }

  var progress = STATE.myProgress.progress || {};
  var passed = progress[lesson.id] && progress[lesson.id].passed;
  html += '<button onclick="openQuiz(\''+f.week.id+'\',\''+lesson.id+'\')" class="btn-primary" style="width:100%;padding:13px;border-radius:14px;border:none;margin-top:10px;">'+
    (passed ? '<i class="fa-solid fa-rotate"></i> Làm lại Quiz' : '<i class="fa-solid fa-pen"></i> Làm Quiz') + '</button>';

if(STATE.adminOn){
    html += '<div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">';
    html += '<button onclick="openLessonForm(\''+f.week.id+'\',\''+lesson.id+'\')" class="btn-gold" style="flex:1;padding:10px;border-radius:12px;border:none;font-size:12px;min-width:90px;">Sửa bài</button>';
    html += '<button onclick="openDayQuizEditor(\''+f.week.id+'\',\''+lesson.id+'\')" class="btn-primary" style="flex:1;padding:10px;border-radius:12px;border:none;font-size:12px;min-width:90px;">Sửa câu hỏi</button>';
    html += '<button onclick="deleteLesson(\''+f.week.id+'\',\''+lesson.id+'\')" style="flex:1;padding:10px;border-radius:12px;border:1px solid #c0392b;color:#c0392b;background:#fff;font-size:12px;min-width:90px;">Xóa bài</button>';
    html += '</div>';
}
  openSheet(html);
}
function imgBlock(i){
  return '<div style="border-radius:10px;overflow:hidden;background:#f4f4f4;margin-bottom:6px;">'+
    (i.url ? '<img src="'+esc(i.url)+'" style="width:100%;height:80px;object-fit:cover;" onerror="this.style.display=\'none\'">' : '<div style="height:60px;display:flex;align-items:center;justify-content:center;color:#bbb;"><i class="fa-solid fa-image"></i></div>') +
    '<div style="font-size:10.5px;padding:4px 6px;color:#555;">'+esc(i.caption||'')+'</div></div>';
}
function renderVideoEmbed(url){
  var ytMatch = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
  if(ytMatch){
    return '<div style="position:relative;padding-bottom:56%;height:0;border-radius:12px;overflow:hidden;margin-bottom:10px;"><iframe src="https://www.youtube.com/embed/'+ytMatch[1]+'" style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;" allowfullscreen></iframe></div>';
  }
  var driveMatch = url.match(/drive\.google\.com\/file\/d\/([\w-]+)/) || url.match(/[?&]id=([\w-]+)/);
  if(driveMatch && url.indexOf('drive.google.com') !== -1){
    return '<div style="position:relative;padding-bottom:56%;height:0;border-radius:12px;overflow:hidden;margin-bottom:10px;"><iframe src="https://drive.google.com/file/d/'+driveMatch[1]+'/preview" style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;" allowfullscreen></iframe></div>';
  }
  if(/\.(mp4|webm|ogg)(\?|$)/i.test(url)){
    return '<video controls style="width:100%;border-radius:12px;margin-bottom:10px;"><source src="'+esc(url)+'"></video>';
  }
  return '<a href="'+esc(url)+'" target="_blank" style="display:block;background:#F5FBF6;border-radius:12px;padding:12px;margin-bottom:10px;font-size:12.5px;color:#2E7D32;text-align:center;"><i class="fa-solid fa-circle-play"></i> Mở video <i class="fa-solid fa-arrow-up-right-from-square"></i></a>';
}

/* ---- QUIZ ---- */
var QUIZ_STATE = null;
function normalizeQuiz_(quiz){
  if(!Array.isArray(quiz)) return [];
  return quiz.map(function(q){
    if(!q || typeof q !== 'object') return null;
    var question = (q.question||'').toString().trim();
    var rawOptions = Array.isArray(q.options) ? q.options : [];
    var options = rawOptions.map(function(o){ return (o===undefined||o===null)?'':String(o).trim(); }).filter(function(o){ return o !== ''; });
    if(!question || options.length < 2) return null;
    var ansIdx = Number(q.answerIndex);
    if(isNaN(ansIdx) || ansIdx < 0 || ansIdx >= options.length) ansIdx = 0;
    return { question: question, options: options, answerIndex: ansIdx, explain: q.explain || '' };
  }).filter(Boolean);
}
function autoGenerateQuiz_(lesson){
  var raw = (lesson.content || '') + '\n' + (lesson.script || '');
  var sentences = raw.split(/[\n\.;]+/).map(function(s){ return s.trim(); })
    .filter(function(s){ return s.length >= 20 && s.length <= 220; });
  if(!sentences.length) return [];
  sentences = sentences.sort(function(){ return Math.random()-0.5; }).slice(0, 5);
  return sentences.map(function(s){
    return {
      question: 'Nội dung sau đây có ĐÚNG với bài "'+lesson.title+'" không? "'+s+'"',
      options: ['Đúng — đây là nội dung chính xác trong bài học', 'Sai — nội dung này không có trong bài học'],
      answerIndex: 0,
      explain: 'Đây là nội dung được trích trực tiếp từ bài học, nên đáp án đúng là "Đúng".'
    };
  });
}

/* ---- Định dạng thời gian làm bài kiểu "1p 20giây" / "45giây" ---- */
function fmtDuration_(sec){
  sec = Math.max(0, Math.round(Number(sec)||0));
  var m = Math.floor(sec/60), s = sec%60;
  return (m>0 ? (m+'p ') : '') + s + 'giây';
}

/* Mở Quiz: đo thời gian làm bài để phục vụ bảng xếp hạng "đúng nhiều nhất, nhanh nhất" */
function shuffleWithAnswer_(q){
  var idxArr = q.options.map(function(_,i){return i;});
  for(var i=idxArr.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=idxArr[i]; idxArr[i]=idxArr[j]; idxArr[j]=t; }
  var newOptions = idxArr.map(function(i){ return q.options[i]; });
  return { question:q.question, options:newOptions, answerIndex: idxArr.indexOf(q.answerIndex), explain: q.explain };
}
function shuffleQuizList_(quiz){
  var arr = quiz.slice();
  for(var i=arr.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=arr[i]; arr[i]=arr[j]; arr[j]=t; }
  return arr.map(shuffleWithAnswer_);
}
function openQuiz(weekId, lessonId){
  var f = findLesson(weekId, lessonId);
  var clean = normalizeQuiz_(f.lesson.quiz);
  if(!clean.length) clean = autoGenerateQuiz_(f.lesson);
  clean = shuffleQuizList_(clean); // XÁO TRỘN câu hỏi + vị trí đáp án đúng mỗi lần làm bài
  QUIZ_STATE = { weekId: weekId, lessonId: lessonId, quiz: clean, idx: 0, correct: 0, answers: [], locked: false, startTime: Date.now() };
  if(clean.length){ SFX.startBg(false); }
  renderQuizStep();
}
function renderQuizStep(){
  QUIZ_STATE.locked = false;
  var total = QUIZ_STATE.quiz.length;
  if(!total){
    var errHtml = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">';
