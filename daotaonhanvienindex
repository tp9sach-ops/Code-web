  html += '<div style="font-weight:800;font-size:18px;">'+correct+'/'+total+' câu đúng</div>';
  html += '<div style="font-size:12px;color:#999;margin:4px 0 6px;">Thời gian làm bài: '+fmtDuration_(durationSec)+'</div>';
  html += '<div style="font-size:13px;color:#666;margin:6px 0 10px;">'+(passed?'Chúc mừng, bạn đã hoàn thành bài học này!':'Cần trả lời đúng 100% để đạt. Hãy thử lại nhé!')+'</div>';
