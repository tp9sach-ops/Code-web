function filterLessonPicker(){
  var q = (document.getElementById('lpSearch').value || '').trim().toLowerCase();
  var rows = document.querySelectorAll('#lpPickerBox .lpItemRow');
  var anyVisible = {};
  rows.forEach(function(row){
    var match = !q || row.dataset.txt.indexOf(q) !== -1;
    row.style.display = match ? '' : 'none';
    if(match) anyVisible[row.closest('div')] = true;
  });
  // Ẩn tiêu đề nhóm nếu tất cả item trong nhóm đó đều bị lọc mất
  document.querySelectorAll('#lpPickerBox .lpGroupTitle').forEach(function(titleEl){
    var el = titleEl.nextElementSibling;
    var hasVisible = false;
    while(el && !el.classList.contains('lpGroupTitle')){
      if(el.classList.contains('lpItemRow') && el.style.display !== 'none') hasVisible = true;
      el = el.nextElementSibling;
    }
    titleEl.style.display = hasVisible ? '' : 'none';
  });
  var totalVisible = document.querySelectorAll('#lpPickerBox .lpItemRow[style*="display: none"]').length;
  var totalAll = rows.length;
  var noRes = document.getElementById('lpNoResult');
  if(noRes) noRes.style.display = (q && totalVisible === totalAll) ? 'block' : 'none';
}
