function kpiTable(title, rows, note){
  var html = '<div class="card" style="padding:14px 16px;margin-bottom:12px;">';
  html += '<div style="font-weight:800;font-size:13px;color:#1B5E20;margin-bottom:8px;">'+esc(title)+'</div>';
  rows.forEach(function(r){
    html += '<div style="display:flex;justify-content:space-between;padding:6px 0;border-top:1px solid #f7f7f7;font-size:12.5px;"><span>'+esc(r[0])+'</span><b style="color:#F5A623;">'+esc(r[1])+'</b></div>';
  });
  if(note) html += '<div style="font-size:11px;color:#888;margin-top:8px;">'+esc(note)+'</div>';
  html += '</div>';
  return html;
}
function calcBonus(){
  var k = STATE.appData.kpi;
  var s = k.seniorityTable[document.getElementById('calcSeniority').value].amount;
  var b = k.breakevenTable[document.getElementById('calcBreakeven').value].percent;
  var h = k.behaviorTable[document.getElementById('calcBehavior').value].percent;
  var total = Math.round(s * (b/100) * (h/100));
  document.getElementById('calcResult').textContent = total.toLocaleString('vi-VN') + 'đ';
}
