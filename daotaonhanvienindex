var DUEL_TIMER = null;
function renderDuelQuestion(){
  clearTimeout(DUEL_TIMER);
  var q = DUEL_STATE.questions[DUEL_STATE.currentIndex];
  var qBox = document.getElementById('duelQuestionBox');
  if(!qBox) return;
  qBox.textContent = q.question;
  document.getElementById('duelQNum').textContent = DUEL_STATE.currentIndex + 1;
  var opts = document.getElementById('duelOptions');
  opts.innerHTML = '';
  var who = myDuelRole();
  var alreadyAnswered = DUEL_STATE[who] && DUEL_STATE[who].answeredIndex === DUEL_STATE.currentIndex;
  q.options.forEach(function(opt, i){
    var b = document.createElement('button');
    b.type = 'button'; b.textContent = opt; b.className = 'duel-opt';
    b.style.cssText = 'width:100%;text-align:left;padding:11px 14px;border-radius:12px;border:1px solid #ddd;margin-bottom:7px;background:#fff;font-size:13px;';
    if(alreadyAnswered){ b.disabled = true; b.style.pointerEvents='none'; b.style.opacity='0.6'; }
    else b.onclick = function(){ answerDuel(i); };
    opts.appendChild(b);
  });
  var waitMsg = document.getElementById('duelWaitMsg');
  if(waitMsg) waitMsg.textContent = alreadyAnswered ? 'Đã gửi câu trả lời — đang chờ đối thủ...' : '';
  var qIndexSnapshot = DUEL_STATE.currentIndex;
  if(!alreadyAnswered){
    DUEL_TIMER = setTimeout(function(){
      if(DUEL_STATE && DUEL_STATE.currentIndex === qIndexSnapshot) serverCall('forceAdvanceDuel', DUEL_STATE.id, qIndexSnapshot).catch(function(){});
    }, 20000);
  }
}
function updateDuelPlayUI(questionChanged){
  var board = document.getElementById('duelScoreBoard');
  if(board) board.innerHTML = duelScoreBoardHtml();
  if(questionChanged) renderDuelQuestion();
  else {
    var who = myDuelRole();
    var waitMsg = document.getElementById('duelWaitMsg');
    var answered = DUEL_STATE[who] && DUEL_STATE[who].answeredIndex === DUEL_STATE.currentIndex;
    if(waitMsg && answered) waitMsg.textContent = 'Đã gửi câu trả lời — đang chờ đối thủ...';
  }
}
async function answerDuel(i){
  clearTimeout(DUEL_TIMER);
  var opts = document.querySelectorAll('#duelOptions .duel-opt');
  opts.forEach(function(o){ o.disabled = true; o.style.pointerEvents='none'; });
  var q = DUEL_STATE.questions[DUEL_STATE.currentIndex];
  if(i === q.answerIndex){ SFX.correct(); if(opts[i]) { opts[i].style.background='#EAF7EC'; opts[i].style.borderColor='#2E7D32'; } }
  else { SFX.wrong(); if(opts[i]) { opts[i].style.background='#FCEBEA'; opts[i].style.borderColor='#c0392b'; } if(opts[q.answerIndex]){ opts[q.answerIndex].style.background='#EAF7EC'; opts[q.answerIndex].style.borderColor='#2E7D32'; } }
  var waitMsg = document.getElementById('duelWaitMsg');
  if(waitMsg) waitMsg.textContent = 'Đã gửi câu trả lời — đang chờ đối thủ...';
  try{
    var d = await serverCall('submitDuelAnswer', DUEL_STATE.id, STATE.session.phone, DUEL_STATE.currentIndex, i);
    var oldIndex = DUEL_STATE.currentIndex;
    DUEL_STATE = d;
    if(d.status === 'finished'){ clearInterval(DUEL_POLL); renderDuelResult(); }
    else if(d.currentIndex !== oldIndex){ renderDuelQuestion(); var b=document.getElementById('duelScoreBoard'); if(b) b.innerHTML = duelScoreBoardHtml(); }
  }catch(e){ /* poll sẽ tự đồng bộ lại */ }
}
function renderDuelResult(){
  var who = myDuelRole();
  var opp = who === 'p1' ? 'p2' : 'p1';
  var me = DUEL_STATE[who], op = DUEL_STATE[opp];
  var iWon = me.score > op.score;
  var isDraw = me.score === op.score;
  if(iWon) SFX.win(); else SFX.wrong();
  var html = '<div style="text-align:center;padding:10px 0;">';
  html += '<i class="fa-solid '+(iWon?'fa-trophy':(isDraw?'fa-handshake':'fa-face-frown'))+'" style="font-size:44px;color:'+(iWon?'#F5A623':(isDraw?'#999':'#c0392b'))+';margin-bottom:10px;"></i>';
  html += '<div style="font-weight:800;font-size:18px;margin-bottom:4px;">'+(iWon?'Bạn thắng!':(isDraw?'Hòa!':'Bạn thua!'))+'</div>';
  html += '<div style="font-size:13px;color:#666;margin-bottom:16px;">'+esc(me.name)+': '+me.score+'đ &nbsp;—&nbsp; '+esc(op.name)+': '+op.score+'đ</div>';
  html += '<button type="button" onclick="closeSheet();switchTab(\'rank\');" class="btn-primary" style="width:100%;padding:12px;border-radius:12px;border:none;">Đóng</button>';
  html += '</div>';
  openSheet(html);
  DUEL_STATE = null;
}
function leaveDuel(){
  clearInterval(DUEL_POLL); clearTimeout(DUEL_TIMER);
