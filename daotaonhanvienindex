function saveLesson(weekId, lessonId){
  var d = STATE.appData;
  var week = d.weeks.find(function(w){return w.id===weekId;});
  var quiz;
  try{ quiz = JSON.parse(document.getElementById('lfQuiz').value); }catch(e){ alert('JSON câu hỏi không hợp lệ: '+e.message); return; }
  if(!Array.isArray(quiz) || !quiz.length){ alert('Cần ít nhất 1 câu hỏi hợp lệ trong Quiz.'); return; }
  for(var qi=0; qi<quiz.length; qi++){
    var qq = quiz[qi];
    if(!qq.question || !Array.isArray(qq.options) || qq.options.length < 2 || typeof qq.answerIndex !== 'number' || qq.answerIndex < 0 || qq.answerIndex >= qq.options.length){
      alert('Câu hỏi #'+(qi+1)+' không hợp lệ: cần "question", ít nhất 2 "options", và "answerIndex" trỏ đúng vào một trong các options.');
      return;
    }
  }
  var newLesson = {
    id: lessonId || genId(weekId+'D', week.lessons),
    title: document.getElementById('lfTitle').value,
    audience: document.getElementById('lfAudience').value,
    content: document.getElementById('lfContent').value,
    script: document.getElementById('lfScript').value,
    videoUrl: document.getElementById('lfVideo').value,
    refLink: document.getElementById('lfRef').value,
    images: (lessonId && findLesson(weekId,lessonId).lesson.images) || [],
    quiz: quiz
  };
  var weeks = d.weeks.map(function(w){
    if(w.id !== weekId) return w;
    var lessons = lessonId ? w.lessons.map(function(l){ return l.id===lessonId ? newLesson : l; }) : w.lessons.concat([newLesson]);
    return Object.assign({}, w, {lessons: lessons});
  });
  saveData('weeks', weeks);
}
function deleteLesson(weekId, lessonId){
  if(!confirm('Xóa bài học này?')) return;
  var weeks = STATE.appData.weeks.map(function(w){
    if(w.id !== weekId) return w;
    return Object.assign({}, w, {lessons: w.lessons.filter(function(l){ return l.id !== lessonId; })});
  });
  saveData('weeks', weeks);
}

