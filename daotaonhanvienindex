/* Đồng bộ câu hỏi (sửa / xóa / thêm mới) về đúng mục kiến thức gốc.
   - originalQuiz: trạng thái câu hỏi lúc MỞ màn chỉnh sửa (để biết câu
     nào bị xóa/sửa so với ban đầu).
   - finalQuiz: trạng thái câu hỏi lúc bấm Lưu. */
function findSourceCollection_(type){
  var map = { sop:'sop', guide:'operationGuides', script:'salesScripts', skill:'sellingSkills', productLine:'productLines', qlch:'qlchContent', b2b:'b2bTopics' };
  return map[type] || null;
}
async function syncQuizToSource_(originalQuiz, finalQuiz){
  if(!STATE.adminOn) return;
  var byCollectionKey = {};
  var weeksCopy = null;
  function ensureCollectionCopy(key){
    if(!byCollectionKey[key]) byCollectionKey[key] = STATE.appData[key].map(function(x){ return Object.assign({}, x, { quiz: (x.quiz||[]).slice() }); });
    return byCollectionKey[key];
  }
  function targetQuizArray_(sourceRef){
    if(sourceRef.type === 'lesson'){
      weeksCopy = weeksCopy || JSON.parse(JSON.stringify(STATE.appData.weeks));
      var found = null;
      weeksCopy.forEach(function(w){ w.lessons.forEach(function(l){ if(l.id===sourceRef.id){ l.quiz = l.quiz||[]; found = l.quiz; } }); });
      return found;
    }
    var colKey = findSourceCollection_(sourceRef.type);
    if(!colKey) return null;
    var list = ensureCollectionCopy(colKey);
    var item = list.find(function(x){ return x.id===sourceRef.id; });
    if(!item) return null;
    item.quiz = item.quiz || [];
    return item.quiz;
  }
  function pushOrReplace_(quizArr, matchQuestion, newQ){
    var idx = matchQuestion ? quizArr.findIndex(function(e){ return e.question === matchQuestion; }) : -1;
    if(newQ === null){ if(idx!==-1) quizArr.splice(idx,1); return; }
    var nq = {question:newQ.question, options:newQ.options, answerIndex:newQ.answerIndex, explain:newQ.explain||''};
    if(idx!==-1) quizArr[idx] = nq; else quizArr.push(nq);
  }

  var finalByOrig = {};
  finalQuiz.forEach(function(q){ if(q.sourceRef && q._origQuestion) finalByOrig[q.sourceRef.type+'|'+q.sourceRef.id+'|'+q._origQuestion] = q; });

  var handled = {};
  originalQuiz.forEach(function(oq){
    if(!oq.sourceRef || !oq._origQuestion) return;
    var key = oq.sourceRef.type+'|'+oq.sourceRef.id+'|'+oq._origQuestion;
    if(handled[key]) return; handled[key] = true;
    var stillThere = finalByOrig[key];
    var arr = targetQuizArray_(oq.sourceRef);
    if(arr) pushOrReplace_(arr, oq._origQuestion, stillThere || null);
  });

  finalQuiz.forEach(function(q){
    if(!q.sourceRef || q._origQuestion) return;
    var arr = targetQuizArray_(q.sourceRef);
    if(!arr) return;
    var already = arr.some(function(e){ return e.question === q.question; });
    if(!already) arr.push({question:q.question, options:q.options, answerIndex:q.answerIndex, explain:q.explain||''});
  });

  var jobs = [];
  Object.keys(byCollectionKey).forEach(function(key){
    jobs.push(serverCall('saveAppData', STATE.adminPassword, key, byCollectionKey[key]).then(function(){ STATE.appData[key] = byCollectionKey[key]; }));
  });
  if(weeksCopy){
    jobs.push(serverCall('saveAppData', STATE.adminPassword, 'weeks', weeksCopy).then(function(){ STATE.appData.weeks = weeksCopy; }));
  }
  try{ await Promise.all(jobs); }catch(e){ /* đồng bộ nguồn là phụ trợ, lỗi ở đây không chặn việc lưu bài học */ }
}

async function confirmLessonEditor(){
  var st = QUIZ_EDITOR_STATE;
  if(!st.title || !st.title.trim()){ alert('Tên bài học không được để trống.'); return; }
  if(!st.content.length){ alert('Bài học cần ít nhất 1 mục nội dung.'); return; }
  if(!st.quiz.length){ alert('Cần ít nhất 1 câu hỏi.'); return; }
  for(var i=0;i<st.quiz.length;i++){
    var q = st.quiz[i];
    if(!q.question || !q.question.trim() || !q.options || q.options.length<2 || q.options.some(function(o){return !o||!o.trim();})){
      alert('Câu hỏi #'+(i+1)+' chưa hợp lệ: cần nội dung câu hỏi và ít nhất 2 đáp án không để trống.');
      return;
    }
  }
  var btn = document.getElementById('peConfirmBtn');
  btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang lưu...';
  try{
    var cleanQuiz = st.quiz.map(function(q){ return {question:q.question, options:q.options, answerIndex:q.answerIndex, explain:q.explain||'', sourceRef:q.sourceRef, _origQuestion:q._origQuestion}; });
    if(st.mode === 'create'){
      var lesson = await serverCall('adminCreateCustomLessonFromData', STATE.adminPassword, st.title, st.content, cleanQuiz);
      await syncQuizToSource_(st.__original || [], cleanQuiz);
      var base = STATE.webAppUrl || window.location.href.split('?')[0];
      var link = base + '?lesson=' + encodeURIComponent(lesson.id);
      var html = '<div style="text-align:center;padding:10px 0;">';
      html += '<i class="fa-solid fa-circle-check" style="font-size:40px;color:#2E7D32;margin-bottom:10px;"></i>';
      html += '<div style="font-weight:800;font-size:15px;margin-bottom:6px;">Đã tạo bài học!</div>';
      html += '<div style="font-size:12px;color:#666;margin-bottom:10px;">'+st.content.length+' mục kiến thức · '+cleanQuiz.length+' câu hỏi</div>';
      html += '<input readonly onclick="this.select()" value="'+esc(link)+'" style="width:100%;padding:10px;border-radius:10px;border:1px solid #ddd;font-size:12px;margin-bottom:12px;text-align:center;">';
      html += '<button type="button" onclick="window.open(\''+link+'\',\'_blank\')" class="btn-primary" style="width:100%;padding:12px;border-radius:12px;border:none;margin-bottom:8px;">Mở bài học ngay</button>';
      html += '<button type="button" onclick="closeSheet();STATE.moreFilter=\'lessons\';renderTab();" class="btn-gold" style="width:100%;padding:12px;border-radius:12px;border:none;">Xong</button>';
      html += '</div>';
      openSheet(html);
    } else {
      await serverCall('adminUpdateCustomLesson', STATE.adminPassword, st.lessonId, { title: st.title, content: st.content, quiz: cleanQuiz });
      await syncQuizToSource_(st.__original || [], cleanQuiz);
      closeSheet();
      loadCustomLessonsList();
      alert('Đã lưu thay đổi bài học.');
    }
  }catch(e){
    btn.disabled = false; btn.innerHTML = (st.mode==='create' ? 'Tạo bài học & lấy link' : 'Lưu thay đổi');
    alert('Lỗi lưu: '+e.message);
  }
  QUIZ_EDITOR_STATE = null;
}
/* ===================== ADMIN: SỬA/XÓA CÂU HỎI QUIZ THEO NGÀY ===================== */
var DAY_QUIZ_EDITOR_STATE = null;

function openDayQuizEditor(weekId, lessonId){
  var f = findLesson(weekId, lessonId);
  var quizCopy = JSON.parse(JSON.stringify(normalizeQuiz_(f.lesson.quiz)));
  DAY_QUIZ_EDITOR_STATE = { weekId: weekId, lessonId: lessonId, lessonTitle: f.lesson.title, quiz: quizCopy };
  renderDayQuizEditor();
}
function renderDayQuizEditor(){
  var st = DAY_QUIZ_EDITOR_STATE;
  var html = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">';
  html += '<div style="font-weight:800;font-size:15px;color:#1B5E20;padding-right:8px;">Sửa câu hỏi — '+esc(st.lessonTitle)+'</div>';
  html += '<button type="button" onclick="closeSheet()" style="background:#f2f2f2;border:none;width:30px;height:30px;border-radius:50%;flex-shrink:0;"><i class="fa-solid fa-xmark"></i></button></div>';
  html += '<div style="font-size:11.5px;color:#888;margin-bottom:10px;">'+st.quiz.length+' câu hỏi. Sửa nội dung câu hỏi/đáp án, đổi đáp án đúng, thêm hoặc xóa câu hỏi.</div>';
  html += '<div id="dqList" style="max-height:420px;overflow-y:auto;padding-right:2px;">';
  st.quiz.forEach(function(q, idx){ html += dqQuestionCardHtml(q, idx); });
  html += '</div>';
  html += '<button type="button" onclick="dqAddQuestion()" class="btn-gold" style="width:100%;padding:11px;border-radius:12px;border:none;margin-top:10px;font-size:13px;"><i class="fa-solid fa-plus"></i> Thêm câu hỏi</button>';
  html += '<button type="button" id="dqSaveBtn" onclick="saveDayQuizEditor()" class="btn-primary" style="width:100%;padding:13px;border-radius:12px;border:none;margin-top:10px;"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button>';
  openSheet(html);
}
function dqQuestionCardHtml(q, idx){
  var h = '<div class="card" style="padding:12px 14px;margin-bottom:10px;" data-qidx="'+idx+'">';
  h += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;"><span style="font-size:11px;font-weight:700;color:#999;">Câu '+(idx+1)+'</span>'+
    '<button type="button" onclick="dqRemoveQuestion('+idx+')" style="background:none;border:none;color:#c0392b;font-size:11px;">Xóa câu hỏi</button></div>';
  h += '<textarea oninput="dqUpdateField('+idx+',\'question\',this.value)" style="width:100%;padding:8px;border-radius:8px;border:1px solid #ddd;font-size:12.5px;margin-bottom:6px;" rows="2">'+esc(q.question)+'</textarea>';
  (q.options||[]).forEach(function(opt, oi){
    h += '<div style="display:flex;align-items:center;gap:6px;margin-bottom:5px;">';
    h += '<input type="radio" name="dqCorrect'+idx+'" '+(q.answerIndex===oi?'checked':'')+' onchange="dqSetCorrect('+idx+','+oi+')">';
    h += '<input value="'+esc(opt)+'" oninput="dqUpdateOption('+idx+','+oi+',this.value)" style="flex:1;padding:7px;border-radius:8px;border:1px solid #ddd;font-size:12px;">';
    if((q.options||[]).length > 2) h += '<button type="button" onclick="dqRemoveOption('+idx+','+oi+')" style="background:none;border:none;color:#c0392b;font-size:12px;">✕</button>';
    h += '</div>';
  });
  h += '<button type="button" onclick="dqAddOption('+idx+')" style="font-size:11px;color:#8a5a00;background:none;border:none;margin-bottom:6px;">+ Thêm đáp án</button>';
  h += '<textarea placeholder="Lưu ý / giải thích đáp án" oninput="dqUpdateField('+idx+',\'explain\',this.value)" style="width:100%;padding:8px;border-radius:8px;border:1px solid #ddd;font-size:12px;margin-top:4px;" rows="2">'+esc(q.explain||'')+'</textarea>';
  h += '</div>';
  return h;
}
function dqRefreshCard_(idx){
  var wrap = document.querySelector('#dqList [data-qidx="'+idx+'"]');
  if(wrap) wrap.outerHTML = dqQuestionCardHtml(DAY_QUIZ_EDITOR_STATE.quiz[idx], idx);
}
function dqUpdateField(idx, field, value){ DAY_QUIZ_EDITOR_STATE.quiz[idx][field] = value; }
function dqUpdateOption(idx, oi, value){ DAY_QUIZ_EDITOR_STATE.quiz[idx].options[oi] = value; }
function dqSetCorrect(idx, oi){ DAY_QUIZ_EDITOR_STATE.quiz[idx].answerIndex = oi; }
function dqAddOption(idx){ DAY_QUIZ_EDITOR_STATE.quiz[idx].options.push('Đáp án mới'); dqRefreshCard_(idx); }
function dqRemoveOption(idx, oi){
  var q = DAY_QUIZ_EDITOR_STATE.quiz[idx];
  if(q.options.length <= 2) return;
  q.options.splice(oi,1);
  if(q.answerIndex === oi) q.answerIndex = 0;
  else if(q.answerIndex > oi) q.answerIndex--;
  dqRefreshCard_(idx);
}
function dqAddQuestion(){
  DAY_QUIZ_EDITOR_STATE.quiz.push({ question:'Câu hỏi mới', options:['Đáp án 1','Đáp án 2','Đáp án 3','Đáp án 4'], answerIndex:0, explain:'' });
  renderDayQuizEditor();
}
function dqRemoveQuestion(idx){
  if(!confirm('Xóa câu hỏi này khỏi bài test?')) return;
  DAY_QUIZ_EDITOR_STATE.quiz.splice(idx,1);
  renderDayQuizEditor();
}
async function saveDayQuizEditor(){
  var st = DAY_QUIZ_EDITOR_STATE;
  if(!st.quiz.length){ alert('Bài test cần ít nhất 1 câu hỏi.'); return; }
  for(var i=0;i<st.quiz.length;i++){
    var q = st.quiz[i];
    if(!q.question || !q.question.trim() || !q.options || q.options.length<2 || q.options.some(function(o){return !o||!o.trim();})){
      alert('Câu hỏi #'+(i+1)+' chưa hợp lệ: cần nội dung câu hỏi và ít nhất 2 đáp án không để trống.');
      return;
    }
  }
  var btn = document.getElementById('dqSaveBtn');
  btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang lưu...';
  var cleanQuiz = st.quiz.map(function(q){ return {question:q.question, options:q.options, answerIndex:q.answerIndex, explain:q.explain||''}; });
  var weeks = STATE.appData.weeks.map(function(w){
    if(w.id !== st.weekId) return w;
    var lessons = w.lessons.map(function(l){ return l.id===st.lessonId ? Object.assign({}, l, {quiz: cleanQuiz}) : l; });
    return Object.assign({}, w, {lessons: lessons});
  });
  try{
    await serverCall('saveAppData', STATE.adminPassword, 'weeks', weeks);
    STATE.appData.weeks = weeks;
    closeSheet();
    DAY_QUIZ_EDITOR_STATE = null;
  }catch(e){
    btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi';
    alert('Lỗi lưu: '+e.message);
  }
}

