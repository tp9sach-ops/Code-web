      storageCold68: document.getElementById('plCold68').value,
      packaging: document.getElementById('plPackaging').value,
      sellingNote: document.getElementById('plSellingNote').value,
      nutritionDeclared: document.getElementById('plNutriDecl').value,
      nutritionLabTest: document.getElementById('plNutriLab').value,
      priceStatus: document.getElementById('plPriceStatus').value,
      linkedProductIds: (pid && d.productLines.find(function(p){return p.id===pid;}).linkedProductIds) || [],
