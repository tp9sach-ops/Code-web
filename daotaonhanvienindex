function moneyFmt_(n){ return (n===null||n===undefined||n==='') ? '—' : Number(n).toLocaleString('vi-VN') + 'đ'; }
function splitSentences_(text){
  return String(text||'').split(/\n+|\.\s+|;\s*/)
    .map(function(s){ return s.trim(); })
    .filter(function(s){
      if(s.length < 25 || s.length > 140) return false;
      var wordCount = s.split(/\s+/).filter(Boolean).length;
      if(wordCount < 4) return false; // loại câu cụt kiểu "Giá 100.000đ" không rõ ngữ cảnh
      return true;
    });
}
function shortenOption_(text){
  var t = String(text||'').trim();
  // Ưu tiên giữ TRỌN VẸN câu trả lời — chỉ cắt khi thực sự quá dài để không vỡ giao diện.
  if(t.length <= 280) return t;
  var dot = t.indexOf('. ');
  if(dot > 10 && dot <= 280) return t.slice(0, dot + 1).trim();
  var cut = t.slice(0, 280);
  var lastDot = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('; '));
  if(lastDot > 60) return cut.slice(0, lastDot + 1).trim();
  var lastSpace = cut.lastIndexOf(' ');
  if(lastSpace > 60) cut = cut.slice(0, lastSpace);
  return cut.trim() + '…';
}
function shuffleArr_(arr){
  var a = arr.slice();
  for(var i=a.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=a[i]; a[i]=a[j]; a[j]=t; }
  return a;
}

/* Gắn nguồn gốc câu hỏi (sourceRef + _origQuestion) để có thể đồng bộ lại
   về đúng mục kiến thức gốc khi Admin sửa/thêm/xóa câu hỏi trong bài học. */
function tagQuizSource_(list, type, id){
  return (list||[]).map(function(q){
    var copy = Object.assign({}, q);
    copy.sourceRef = { type: type, id: id };
    copy._origQuestion = q.question;
    return copy;
  });
}
function tagQuizSource_(list, type, id){
  return (list||[]).map(function(q){
    var copy = Object.assign({}, q);
    copy.sourceRef = { type: type, id: id };
    copy._origQuestion = q.question;
    return copy;
  });
}
function buildLessonContentClientSide_(refs){
  var d = STATE.appData;
  var contentBlocks = [];
  var quizPool = [];
  var sopMCQCandidates = [];
  refs.forEach(function(ref){
    if(ref.type==='lesson'){
      d.weeks.forEach(function(w){ w.lessons.forEach(function(l){ if(l.id===ref.id){
        contentBlocks.push({ title: l.title, body: (l.content||'')+(l.script?('\n\nKịch bản: '+l.script):''), image: (l.images && l.images.length ? (l.images[0].url||'') : '') });
        quizPool = quizPool.concat(tagQuizSource_(l.quiz, 'lesson', l.id));
      }}); });
    } else if(ref.type==='sop'){
      var s = d.sop.filter(function(x){return x.id===ref.id;})[0];
      if(s){
        contentBlocks.push({ title: s.situation, body: 'Cách xử lý: '+s.solution+(s.note?('\n\nLưu ý: '+s.note):''), image: s.imageUrl||'' });
        sopMCQCandidates.push({ situation: s.situation, solution: s.solution });
        quizPool = quizPool.concat(tagQuizSource_(s.quiz, 'sop', s.id));
      }
    } else if(ref.type==='guide'){
      var g = d.operationGuides.filter(function(x){return x.id===ref.id;})[0];
      if(g){ contentBlocks.push({ title: g.title, body: (g.steps||[]).join('\n')+(g.note?('\n\nLưu ý: '+g.note):''), image: g.imageUrl||'' }); quizPool = quizPool.concat(tagQuizSource_(g.quiz, 'guide', g.id)); }
    } else if(ref.type==='script'){
      var sc = d.salesScripts.filter(function(x){return x.id===ref.id;})[0];
      if(sc){ contentBlocks.push({ title: sc.situation, body: sc.script+(sc.tip?('\n\nMẹo: '+sc.tip):''), image: sc.imageUrl||'' }); quizPool = quizPool.concat(tagQuizSource_(sc.quiz, 'script', sc.id)); }
    } else if(ref.type==='skill'){
      var sk = d.sellingSkills.filter(function(x){return x.id===ref.id;})[0];
      if(sk){ contentBlocks.push({ title: sk.title, body: sk.desc+(sk.example?('\n\nVí dụ: '+sk.example):''), image: sk.imageUrl||'' }); quizPool = quizPool.concat(tagQuizSource_(sk.quiz, 'skill', sk.id)); }
    } else if(ref.type==='productLine'){
      var p = d.productLines.filter(function(x){return x.id===ref.id;})[0];
      if(p){
        var baseName = (p.name||'').split('(')[0].trim();
        var priceLines = (d.products||[]).filter(function(pr){
          return pr.name && baseName && (pr.name.indexOf(baseName)!==-1 || baseName.indexOf(pr.name)!==-1);
        }).map(function(pr){ return pr.name+(pr.size?(' — '+pr.size):'')+': '+moneyFmt_(pr.price); });
        var bodyTxt = 'Thành phần: '+(p.ingredients||'—')+'\n\nBảo quản đông lạnh: '+(p.storageFrozen||'—')+'\nBảo quản mát: '+(p.storageCold05||p.storageCold68||'—');
        if(priceLines.length) bodyTxt += '\n\nGiá bán:\n'+priceLines.join('\n');
        else if(p.priceStatus) bodyTxt += '\n\nGiá: '+p.priceStatus;
        contentBlocks.push({ title: p.name, body: bodyTxt, image: p.imageUrl||'' });
        quizPool = quizPool.concat(tagQuizSource_(p.quiz, 'productLine', p.id));
      }
    } else if(ref.type==='qlch'){
      var q1 = d.qlchContent.filter(function(x){return x.id===ref.id;})[0];
      if(q1){ contentBlocks.push({ title: (q1.title||q1.question||''), body: (q1.content||q1.answer||'(Chưa có nội dung)'), image: q1.imageUrl||'' }); quizPool = quizPool.concat(tagQuizSource_(q1.quiz, 'qlch', q1.id)); }
    } else if(ref.type==='b2b'){
      var b1 = d.b2bTopics.filter(function(x){return x.id===ref.id;})[0];
      if(b1){ contentBlocks.push({ title: (b1.title||b1.topic||''), body: (b1.content||b1.detail||'(Chưa có nội dung)'), image: b1.imageUrl||'' }); quizPool = quizPool.concat(tagQuizSource_(b1.quiz, 'b2b', b1.id)); }
    }
  });
 
  var quiz = quizPool.map(function(q){ return {question:q.question, options:q.options, answerIndex:q.answerIndex, explain:q.explain||'', sourceRef:q.sourceRef, _origQuestion:q._origQuestion}; });
 
  // Sinh câu hỏi tình huống-SOP ngay cả khi chỉ chọn 2-3 mục (không bắt buộc >=4 nữa),
  // và tự thích ứng số đáp án theo số "mục khác" thực có (tối thiểu 2 đáp án, tối đa 4).
  if(sopMCQCandidates.length >= 2){
    shuffleArr_(sopMCQCandidates).forEach(function(s){
      var others = sopMCQCandidates.filter(function(x){ return x.situation!==s.situation; });
      if(others.length < 1) return;
      var correctOpt = shortenOption_(s.solution);
      var maxDistractors = Math.min(3, others.length);
      var distractors = shuffleArr_(others).slice(0, maxDistractors).map(function(o){ return shortenOption_(o.solution); });
      var options = shuffleArr_([correctOpt].concat(distractors));
      quiz.push({ question: 'Theo quy định 9 Sạch, tình huống "'+s.situation+'" cần xử lý thế nào?', options: options, answerIndex: options.indexOf(correctOpt), explain: 'Trích trực tiếp từ quy định "'+s.situation+'".' });
    });
  }
 
  // Luôn bổ sung thêm câu hỏi từ nội dung chi tiết (không chỉ khi quiz rỗng) để đảm bảo
  // đủ số lượng câu hỏi giúp ghi nhớ, kể cả khi đã có câu hỏi tình huống-SOP ở trên.
  {
    var facts = [];
    contentBlocks.forEach(function(block, bi){
      splitSentences_(block.body).forEach(function(sTxt){ facts.push({ text: sTxt, blockIdx: bi, title: block.title }); });
    });
    var usedFact = {}, guard = 0;
    var fallbackTarget = Math.max(10, contentBlocks.length * 3);
    while(quiz.length < fallbackTarget && facts.length >= 4 && guard < 400){
      guard++;
      var pick = facts[Math.floor(Math.random()*facts.length)];
      var key = pick.blockIdx+'|'+pick.text;
      if(usedFact[key]) continue;
      usedFact[key] = true;
      var others2 = facts.filter(function(x){ return x.blockIdx !== pick.blockIdx; });
      if(others2.length < 3) continue;
      var distractors2 = shuffleArr_(others2).slice(0,3).map(function(o){ return o.text; });
      var options2 = shuffleArr_([pick.text].concat(distractors2));
      var useReverseType = (quiz.length % 2 === 1);
      if(useReverseType){
        var topicPool = shuffleArr_(others2).slice(0,6).map(function(o){return o.title;});
        var uniqueTopics = [];
        topicPool.forEach(function(t){ if(t!==pick.title && uniqueTopics.indexOf(t)===-1) uniqueTopics.push(t); });
        if(uniqueTopics.length >= 3){
          var topicOptions = shuffleArr_([pick.title].concat(uniqueTopics.slice(0,3)));
          quiz.push({ question: 'Thông tin sau đây thuộc về mục kiến thức nào? "'+pick.text+'"', options: topicOptions, answerIndex: topicOptions.indexOf(pick.title), explain: 'Thông tin này được trích từ mục "'+pick.title+'".' });
          continue;
        }
      }
      quiz.push({ question: 'Câu nào dưới đây mô tả ĐÚNG về "'+pick.title+'"?', options: options2, answerIndex: options2.indexOf(pick.text), explain: 'Trích trực tiếp từ nội dung "'+pick.title+'".' });
    }
  }
 
  return { content: contentBlocks, quiz: quiz };
}

