function startDuelPolling(){
  clearInterval(DUEL_POLL);
  DUEL_POLL = setInterval(async function(){
    if(!DUEL_STATE) { clearInterval(DUEL_POLL); return; }
    try{
      var d = await serverCall('getDuelState', DUEL_STATE.id);
      var wasWaiting = DUEL_STATE.status === 'waiting';
      var wasIndex = DUEL_STATE.currentIndex;
      DUEL_STATE = d;
      if(wasWaiting && d.status === 'playing'){
        renderDuelPlay();
      } else if(d.status === 'playing'){
        updateDuelPlayUI(wasIndex !== d.currentIndex);
      } else if(d.status === 'finished'){
        clearInterval(DUEL_POLL);
        renderDuelResult();
      }
    }catch(e){ /* phòng đã đóng hoặc lỗi mạng tạm thời — bỏ qua, thử lại lượt sau */ }
  }, 1500);
}
function myDuelRole(){
  if(!DUEL_STATE || !STATE.session) return null;
  if(DUEL_STATE.p1.phone === STATE.session.phone) return 'p1';
  if(DUEL_STATE.p2 && DUEL_STATE.p2.phone === STATE.session.phone) return 'p2';
